<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Light palette: Fluent 2 / Windows 11 neutrals with the Windows blue accent. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="LayerBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Text2Brush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="Text3Brush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EBF3FC" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="OkBrush" Color="#107C10" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="WarnBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarnStrokeBrush" Color="#F2D58A" />
    <SolidColorBrush x:Key="NewBrush" Color="#8764B8" />
    <SolidColorBrush x:Key="NewSoftBrush" Color="#F1EBFA" />
    <SolidColorBrush x:Key="MarkBrush" Color="#FFE58F" />
    <SolidColorBrush x:Key="MarkTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ToastBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastAccentBrush" Color="#9CCBF5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE7E9" />
    <!-- Marker: ThemeService finds our palette by this key (Fluent has its own Light/Dark files). -->
    <sys:String x:Key="NetWatcherPalette">Light</sys:String>
</ResourceDictionary>
