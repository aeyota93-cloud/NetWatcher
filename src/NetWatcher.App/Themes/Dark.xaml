<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Dark palette: Fluent 2 / Windows 11 neutrals with the Windows blue accent. -->
    <SolidColorBrush x:Key="BgBrush" Color="#202020" />
    <SolidColorBrush x:Key="LayerBrush" Color="#272727" />
    <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Text2Brush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="Text3Brush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CA0E0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#62ABE3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3347" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1A27" />
    <SolidColorBrush x:Key="SelBrush" Color="#24384B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#323232" />
    <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#203A1E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#433519" />
    <SolidColorBrush x:Key="WarnStrokeBrush" Color="#6B5418" />
    <SolidColorBrush x:Key="NewBrush" Color="#B79CE6" />
    <SolidColorBrush x:Key="NewSoftBrush" Color="#382D4A" />
    <SolidColorBrush x:Key="MarkBrush" Color="#7A6100" />
    <SolidColorBrush x:Key="MarkTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastAccentBrush" Color="#9CCBF5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#442726" />
    <SolidColorBrush x:Key="LossBrush" Color="#D9A440" />
    <!-- Marker: ThemeService finds our palette by this key (Fluent has its own Light/Dark files). -->
    <sys:String x:Key="NetWatcherPalette">Dark</sys:String>
</ResourceDictionary>
