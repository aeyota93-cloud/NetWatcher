<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Dark palette: «Панель наблюдения», violet accent; the menu on the left is dark in both themes. -->
    <SolidColorBrush x:Key="BgBrush" Color="#17171D" />
    <SolidColorBrush x:Key="LayerBrush" Color="#202027" />
    <SolidColorBrush x:Key="CardBrush" Color="#25252D" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#36333F" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="#4A4656" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEEDF3" />
    <SolidColorBrush x:Key="Text2Brush" Color="#C6C3D0" />
    <SolidColorBrush x:Key="Text3Brush" Color="#AAA6B7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#BF9BF2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#CFB3F6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#30283F" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelBrush" Color="#3B3052" />
    <SolidColorBrush x:Key="HoverBrush" Color="#292931" />
    <SolidColorBrush x:Key="OkBrush" Color="#65C4A3" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#1E3A30" />
    <SolidColorBrush x:Key="WarnBrush" Color="#EBBC7D" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#3A3026" />
    <SolidColorBrush x:Key="WarnStrokeBrush" Color="#5E4A2C" />
    <SolidColorBrush x:Key="NewBrush" Color="#BF9BF2" />
    <SolidColorBrush x:Key="NewSoftBrush" Color="#30283F" />
    <SolidColorBrush x:Key="MarkBrush" Color="#7A6100" />
    <SolidColorBrush x:Key="MarkTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastBrush" Color="#3A3844" />
    <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToastAccentBrush" Color="#CDB6F2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F19C9F" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#442A2C" />
    <SolidColorBrush x:Key="LossBrush" Color="#D9A440" />
    <!-- Filled buttons: the accent is too light for white text in the dark theme. -->
    <SolidColorBrush x:Key="ActionBrush" Color="#8050BC" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#8F62C8" />
    <SolidColorBrush x:Key="NavBrush" Color="#202023" />
    <SolidColorBrush x:Key="NavLineBrush" Color="#39363F" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#C7C3CE" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#2E2C33" />
    <SolidColorBrush x:Key="NavSelBrush" Color="#3B304B" />
    <SolidColorBrush x:Key="NavSelTextBrush" Color="#E7D8FF" />
    <!-- Standard controls (check boxes, sliders) take the same accent. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8050BC" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8F62C8" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8F62C8" />
    <!-- Marker: ThemeService finds our palette by this key (Fluent has its own Light/Dark files). -->
    <sys:String x:Key="NetWatcherPalette">Dark</sys:String>
</ResourceDictionary>
