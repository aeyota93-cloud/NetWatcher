<Window x:Class="NetWatcher.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Настройки" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock Text="Внешний вид" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border Style="{StaticResource SegmentHost}" Height="34" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="Как в Windows" />
                <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="Светлая" />
                <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="Тёмная" />
            </StackPanel>
        </Border>

        <TextBlock Text="Журнал" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBox x:Name="Retention" DockPanel.Dock="Right" Width="80" Padding="6,4" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Сколько дней хранить историю" />
                        <TextBlock Text="От 1 до 365. Старое удаляется само" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBox x:Name="Poll" DockPanel.Dock="Right" Width="80" Padding="6,4" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Как часто опрашивать соединения, секунд" />
                        <TextBlock Text="От 1 до 60. Короткие соединения ловятся и между опросами" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <CheckBox x:Name="HideLoopback" Content="Скрывать обращения к самому компьютеру (127.0.0.1, ::1)" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="DbInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Style="{StaticResource BtnSmall}" Content="Открыть папку" Margin="12,0,0,0" Click="OnOpenFolder" />
            <Button Style="{StaticResource BtnSmall}" Content="Очистить историю" Margin="8,0,0,0" Click="OnClear" />
        </StackPanel>

        <TextBlock Text="База владельцев IP" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Таблица «диапазон адресов → номер сети (AS) → владелец» с iptoasn.com, около 7 МБ. Нужна для колонок «Владелец», «Сеть» и списков сетей владельцев. Обновлять достаточно раз в месяц." />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AsnButton" Style="{StaticResource BtnSmall}" Content="Скачать базу" Click="OnDownloadAsn" />
            <TextBlock x:Name="AsnInfo" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Style="{StaticResource Muted}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Style="{StaticResource BtnPrimary}" Content="Сохранить" IsDefault="True" Click="OnSave" />
            <Button Style="{StaticResource Btn}" Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
