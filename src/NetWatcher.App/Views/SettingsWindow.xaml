<Window x:Class="NetWatcher.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Настройки" Width="580" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/NetWatcher;component/Assets/NetWatcher.ico"
        Style="{StaticResource BaseWindow}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="20,12,20,20">
        <TextBlock x:Name="VersionText" Style="{StaticResource Faint}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnPrimary}" Content="Сохранить" IsDefault="True" Click="OnSave" />
            <Button Style="{StaticResource Btn}" Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
        </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,20,20,0">
        <TextBlock Text="Внешний вид" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border Style="{StaticResource SegmentHost}" Height="34" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="Как в Windows" />
                <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="Светлая" />
                <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="Тёмная" />
            </StackPanel>
        </Border>

        <TextBlock Text="Уведомления о новом" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Уведомление Windows, когда программа делает что-то впервые. Первые сутки после установки NetWatcher только запоминает, что для этого компьютера обычно. Несколько событий подряд складываются в одно уведомление, не чаще раза в 30 секунд." />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="AlertProgram" Content="Программа впервые вышла в интернет" Margin="0,0,0,6" />
                <CheckBox x:Name="AlertCountry" Content="Программа обратилась к серверу в новой для неё стране" Margin="0,0,0,6" />
                <CheckBox x:Name="AlertNetwork" Content="Программа обратилась в новую для неё сеть (AS) — бывает часто" Margin="0,0,0,6" />
                <CheckBox x:Name="AlertSkipBrowsers" Content="Для браузеров — только первый выход в сеть (каждый сайт — новая страна и сеть)" />
            </StackPanel>
        </Border>

        <TextBlock Text="Журнал" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,8" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBox x:Name="Retention" DockPanel.Dock="Right" Width="80" Padding="6,4" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Сколько дней хранить историю" />
                        <TextBlock Text="От 1 до 365. Старое удаляется само" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBox x:Name="Poll" DockPanel.Dock="Right" Width="80" Padding="6,4" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Как часто опрашивать соединения, секунд" />
                        <TextBlock Text="От 1 до 60. Короткие соединения ловятся и между опросами" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <CheckBox x:Name="HideLoopback" Content="Скрывать обращения к самому компьютеру (127.0.0.1, ::1)" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="DbInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Style="{StaticResource BtnSmall}" Content="Открыть папку" Margin="12,0,0,0" Click="OnOpenFolder" />
            <Button Style="{StaticResource BtnSmall}" Content="Очистить историю" Margin="8,0,0,0" Click="OnClear" />
        </StackPanel>

        <TextBlock Text="База владельцев IP" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Таблица «диапазон адресов → номер сети (AS) → владелец» с iptoasn.com, около 7 МБ. Нужна для колонок «Владелец», «Сеть» и списков сетей владельцев. Копия встроена в программу; кнопка обновляет её — сначала с GitHub (копия обновляется раз в неделю), потом с iptoasn.com." />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AsnButton" Style="{StaticResource BtnSmall}" Content="Скачать базу" Click="OnDownloadAsn" />
            <Button Style="{StaticResource BtnSmall}" Content="Загрузить из файла…" Margin="8,0,0,0" Click="OnImportAsn"
                    ToolTip="Если скачать не получается: откройте iptoasn.com/data/ip2asn-combined.tsv.gz в браузере и укажите скачанный файл" />
            <TextBlock x:Name="AsnInfo" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Style="{StaticResource Muted}" />
        </StackPanel>

        <TextBlock Text="База стран" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Где физически стоит сервер — по таблице DB-IP «IP to Country Lite», около 4 МБ, обновляется раз в месяц. Без неё страна показывается по месту регистрации сети: у Cloudflare, Google или Amazon это почти всегда США, хотя сервер может быть во Франкфурте. Копия встроена в программу." />
        <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0">
            <Hyperlink NavigateUri="https://db-ip.com" RequestNavigate="OnLink">IP Geolocation by DB-IP</Hyperlink><Run Text=" · лицензия CC BY 4.0" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="GeoButton" Style="{StaticResource BtnSmall}" Content="Обновить базу" Click="OnDownloadGeo" />
            <Button Style="{StaticResource BtnSmall}" Content="Загрузить из файла…" Margin="8,0,0,0" Click="OnImportGeo"
                    ToolTip="Если скачать не получается: скачайте «IP to Country Lite» (CSV) на db-ip.com и укажите файл" />
            <TextBlock x:Name="GeoInfo" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Style="{StaticResource Muted}" />
        </StackPanel>

        <TextBlock Text="Каталог доменов" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Какой компании принадлежит домен и не трекер ли это: домены рекламы и аналитики, которые DuckDuckGo блокирует целиком, и адреса телеметрии Windows из списка WindowsSpyBlocker. Около 5 600 доменов; копия встроена в программу и обновляется раз в неделю на GitHub. Пометки — оценка этих списков, а не приговор." />
        <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap">
            <Hyperlink NavigateUri="https://github.com/duckduckgo/tracker-blocklists" RequestNavigate="OnLink">DuckDuckGo Tracker Blocklists</Hyperlink><Run Text=" (CC BY-NC-SA 4.0) · " /><Hyperlink NavigateUri="https://github.com/crazy-max/WindowsSpyBlocker" RequestNavigate="OnLink">WindowsSpyBlocker</Hyperlink><Run Text=" (MIT)" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CatalogButton" Style="{StaticResource BtnSmall}" Content="Обновить каталог" Click="OnDownloadCatalog" />
            <TextBlock x:Name="CatalogInfo" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Style="{StaticResource Muted}" />
        </StackPanel>

    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
