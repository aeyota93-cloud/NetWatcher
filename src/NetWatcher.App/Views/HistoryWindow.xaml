<Window x:Class="NetWatcher.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="История трафика Windows" Width="720" Height="600" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/NetWatcher;component/Assets/NetWatcher.ico"
        Style="{StaticResource BaseWindow}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Трафик по данным Windows" FontSize="16" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                   Text="Windows сама считает трафик каждого приложения — те же данные, что в Параметрах: Сеть и Интернет → Использование данных. Поэтому здесь видно и время до установки NetWatcher. Экспериментально: что Windows отдаст программе, зависит от версии системы." />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox x:Name="Period" DockPanel.Dock="Left" Width="130" SelectionChanged="OnFilter">
                <ComboBoxItem Content="Сутки" Tag="1" />
                <ComboBoxItem Content="7 дней" Tag="7" />
                <ComboBoxItem Content="30 дней" Tag="30" IsSelected="True" />
            </ComboBox>
            <ComboBox x:Name="Network" DockPanel.Dock="Left" Width="220" Margin="8,0,0,0" SelectionChanged="OnNetwork" />
            <TextBlock x:Name="Total" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Закрыть" IsCancel="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Копировать" Margin="0,0,8,0" Click="OnCopy" VerticalAlignment="Center" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Muted}" />
        </DockPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  BorderThickness="0" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                  CanUserResizeRows="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Приложение" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Получено" Binding="{Binding ReceivedText}" SortMemberPath="Received" Width="100" />
                <DataGridTextColumn Header="Отправлено" Binding="{Binding SentText}" SortMemberPath="Sent" Width="100" />
                <DataGridTextColumn Header="Всего" Binding="{Binding TotalText}" SortMemberPath="Total" Width="100" SortDirection="Descending" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
