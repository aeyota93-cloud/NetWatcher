            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource ToastTextBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ToastTitle}" Foreground="{DynamicResource ToastTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastValue}" Foreground="{DynamicResource ToastAccentBrush}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Button Content="Отменить" Margin="14,0,0,0" Command="{Binding UndoCopyCommand}" Cursor="Hand"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#BBBBBB" TextDecorations="Underline" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Page: connection check ============ -->
        <Grid Grid.RowSpan="5" DataContext="{Binding Diagnostics}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Закрыть (Esc)" Command="{Binding CloseCommand}" />
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Проверка соединения" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Command="{Binding CopyCommand}" IsEnabled="{Binding HasVerdict}"
                                    ToolTip="Текст для отправки в чат: итог, шаги и трасса">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Копировать отчёт" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="С включённым VPN проверка идёт через него." Style="{StaticResource Faint}" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                        <StackPanel>
                            <!-- What to check -->
                            <DockPanel Margin="0,0,0,6">
                                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Button Style="{StaticResource BtnPrimary}" Height="36" Content="Проверить" Command="{Binding RunCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource NotVis}}" />
                                    <Button Style="{StaticResource Btn}" Height="36" Content="Остановить" Command="{Binding StopCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <Border Height="36" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Stroke2Brush}" BorderThickness="1,1,1,2">
                                    <Grid Margin="10,0">
                                        <TextBox x:Name="CheckBox" Style="{StaticResource BareTextBox}" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Что проверить">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding RunCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="Сайт или адрес: youtube.com, 1.2.3.4, example.com:8443" Style="{StaticResource Faint}" FontSize="14"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=CheckBox, Converter={StaticResource TextVis}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding Error, Converter={StaticResource TextVis}}" />

                            <!-- Verdict -->
                            <Border CornerRadius="8" Padding="14,12" Margin="0,8,0,14" BorderThickness="1"
                                    Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnStrokeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="0,2,12,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE930;" />
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                        <Setter Property="Text" Value="&#xEA39;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- The check went through a VPN: the measurements describe the tunnel. -->
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,1,0,0" Padding="7,2" CornerRadius="5"
                                            Background="{DynamicResource AccentSoftBrush}" ToolTip="{Binding VpnNote}" ToolTipService.InitialShowDelay="200"
                                            Visibility="{Binding HasVpn, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE705;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="VPN" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding VerdictTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Steps -->
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StepView}">
                                        <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xEA3A;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Text" Value="&#xE895;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warn">
                                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                    <Setter Property="Text" Value="&#xE738;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Width="170" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Route -->
                            <StackPanel Visibility="{Binding HasHops, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"><Run Text="проб на узел: " /><Run Text="{Binding Rounds, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="ТРАССА — ПУТЬ ПАКЕТОВ ПО УЗЛАМ (КАК MTR)" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold"
                                           Visibility="{Binding HasVpn, Converter={StaticResource BoolToVis}}"
                                           Text="Проверка шла через VPN: трасса показывает туннель, а не путь до сервера через провайдера." />
                                <TextBlock Style="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="«*» — узел не отвечает. Потери на промежуточном узле, которые не продолжаются дальше, — это роутер ограничивает ответы, а не проблема. Важны потери, которые тянутся до последнего узла. «(+1)» — на этом шаге отвечают разные роутеры (балансировка)." />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                    <Grid Margin="12,6,12,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
                                        </Grid.Resources>
                                        <TextBlock Text="№" />
                                        <TextBlock Grid.Column="1" Text="АДРЕС" />
                                        <TextBlock Grid.Column="2" Text="ПОТЕРИ" />
                                        <TextBlock Grid.Column="3" Text="СР." ToolTip="Средняя задержка, мс" />
                                        <TextBlock Grid.Column="4" Text="ЛУЧШ." ToolTip="Лучшая задержка, мс" />
                                        <TextBlock Grid.Column="5" Text="ХУДШ." ToolTip="Худшая задержка, мс" />
                                        <TextBlock Grid.Column="6" Text="ВЛАДЕЛЕЦ СЕТИ" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Hops}" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HopView}">
                                                <Border Style="{StaticResource HoverRow}">
                                                <Grid Margin="12,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Silent}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Text="{Binding Ttl}" Style="{StaticResource Faint}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Loss}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLoss}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding Avg}" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Best}" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Worst}" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Owner}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Owner}" />
                                                </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Pages: blocks and settings ============ -->
        <v:BlocksPage x:Name="BlocksView" Grid.RowSpan="5" Visibility="{Binding IsBlocksPage, Converter={StaticResource BoolToVis}}" />
        <v:SettingsPage x:Name="SettingsView" Grid.RowSpan="5" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />

        <!-- ============ Export side panel ============ -->
        <Grid Grid.RowSpan="5" DataContext="{Binding Export}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#47000000" MouseLeftButtonDown="OnScrimClick" />
            <Border Width="560" HorizontalAlignment="Right" Background="{DynamicResource LayerBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,18,20,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Закрыть (Esc)" Command="{Binding CloseCommand}" />
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Экспорт списка" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Context}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="12,2,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Enter — копировать" Style="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CopyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                        <TextBlock Text="Копировать" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Margin="8,0,0,0" Content="Сохранить .txt…" Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="20,0,20,12">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Что выгрузить" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}" Height="34" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="IP-адреса" IsChecked="{Binding IsAddresses}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="Домены" IsChecked="{Binding IsDomains}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="Подсети" IsChecked="{Binding IsSubnets}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="Сети владельцев" IsChecked="{Binding IsOwners}"
                                                 ToolTip="Целые блоки, которые объявляет владелец (по базе AS)" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,16,0,0" IsEnabled="{Binding WidthEnabled}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WidthText}" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Text="Насколько укрупнять" FontWeight="SemiBold" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                        Value="{Binding Width}" Margin="0,6,0,0" AutomationProperties.Name="Насколько укрупнять подсети" />
                                <UniformGrid Columns="5" Margin="0,2,0,0">
                                    <TextBlock Text="точно" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Text="/28" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,40,0" />
                                    <TextBlock Text="/24" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="/20" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="40,0,0,0" />
                                    <TextBlock Text="/16" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Шире — меньше строк, но в список попадут и соседние адреса, которые программа не использовала." />
                            </StackPanel>

                            <TextBlock Text="Куда будете вставлять" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6" />
                            <UniformGrid Columns="2" IsEnabled="{Binding TargetEnabled}">
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsLines}">
                                    <StackPanel>
                                        <TextBlock Text="Список по строкам" FontWeight="SemiBold" />
                                        <TextBlock Text="Обычный текст, одна сеть в строке" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsWireGuard}">
                                    <StackPanel>
                                        <TextBlock Text="WireGuard / AmneziaWG" FontWeight="SemiBold" />
                                        <TextBlock Text="AllowedIPs = 1.2.3.0/24, …" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsFirewall}">
                                    <StackPanel>
                                        <TextBlock Text="Файрвол Windows" FontWeight="SemiBold" />
                                        <TextBlock Text="Через запятую, для поля «Удалённые IP-адреса»" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsMask}">
                                    <StackPanel>
                                        <TextBlock Text="С маской" FontWeight="SemiBold" />
                                        <TextBlock Text="1.2.3.0 255.255.255.0 — для роутеров" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <CheckBox Content="Только IPv4" IsChecked="{Binding Ipv4Only}" Margin="0,0,20,0" />
                                <CheckBox Content="Комментарии с доменами" IsChecked="{Binding Comments}" IsEnabled="{Binding CommentsEnabled}"
                                          ToolTip="Добавляет в конец строки # домены, которые ведут в эту сеть" />
                            </StackPanel>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Faint}" FontSize="12" />
                                <TextBlock Text="Предпросмотр" FontWeight="SemiBold" FontSize="12" />
                            </DockPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Field}" Padding="10,8">
                            <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
