                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding LiveText}">
                    <!-- A slowly breathing dot says "recording" without a ticking number. -->
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveOk}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Breathe">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Breathe" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LiveOk}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
