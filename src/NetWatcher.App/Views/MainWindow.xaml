<Window x:Class="NetWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        xmlns:vm="clr-namespace:NetWatcher.App.ViewModels"
        xmlns:v="clr-namespace:NetWatcher.App.Views"
        Title="NetWatcher"
        Width="1400" Height="880" MinWidth="1180" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/NetWatcher;component/Assets/NetWatcher.ico"
        Style="{StaticResource BaseWindow}">

    <Window.Resources>
        <v:InverseBoolToVisibility x:Key="NotVis" />
        <v:NotEmptyToVisibility x:Key="TextVis" />
        <v:UpperCase x:Key="Upper" />
        <v:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <v:AllTrueToVisibility x:Key="AllVis" />

        <!-- Letter avatar or real icon of a program. -->
        <DataTemplate x:Key="Avatar" DataType="{x:Type vm:NavItem}">
            <Grid Width="28" Height="28">
                <Border CornerRadius="7" Background="{Binding Color}" Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}">
                    <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding Icon}" Width="22" Height="22" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Context menu shared by right click and the "⋯" button of each row. -->
        <ContextMenu x:Key="RowMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Копировать IP" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyIpCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Копировать домены" Command="{Binding CopyDomainCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Копировать сеть владельца" Command="{Binding CopyNetworkCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Копировать строки целиком" InputGestureText="Ctrl+C" Command="{Binding CopyRowCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Найти всё с этим IP" Command="{Binding SearchIpCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Найти всё с этим доменом" Command="{Binding SearchDomainCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Найти всё этой программы" Command="{Binding SearchProgramCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Проверить соединение…" InputGestureText="Ctrl+D" Command="{Binding OpenCheckCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Подробно о сети (RDAP)" Command="{Binding RdapCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Открыть папку программы" Command="{Binding OpenFolderCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Заблокировать…" Command="{Binding BlockCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Снять блокировку…" Command="{Binding UnblockCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Разорвать соединение…" Command="{Binding CloseConnectionCommand}"
                      ToolTip="Закрыть открытые TCP-соединения программы с этим адресом: она увидит обрыв и подключится заново"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- Rows: no grid lines, a soft hover, the accent-tinted selection. -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChild}" Value="True">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <!-- Row action buttons appear on hover or selection only. -->
        <Style x:Key="RowActions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepMark" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Command bar ============ -->
        <Grid Margin="16,12,16,10">
            <Grid.ColumnDefinitions>
                <!-- Search takes almost all free space (20 : 1 with the spacer) up to 560 px. -->
                <ColumnDefinition Width="20*" MinWidth="300" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchFrame" Height="36" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderThickness="1,1,1,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke2Brush}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text2Brush}" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Поиск"
                             ToolTip="Ищет по программе, службе, IP, порту, домену, владельцу и стране. Несколько слов — все должны совпасть. 142.250.0.0/15 — адреса внутри подсети." />
                    <TextBlock Grid.Column="1" Text="Программа, служба, домен, IP или подсеть 10.0.0.0/8" Style="{StaticResource Faint}"
                               FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasSearch, Converter={StaticResource NotVis}}" />
                    <Border Grid.Column="2" BorderBrush="{DynamicResource Stroke2Brush}" BorderThickness="1" CornerRadius="4" Padding="5,1"
                            Visibility="{Binding HasSearch, Converter={StaticResource NotVis}}">
                        <TextBlock Text="Ctrl+F" FontSize="11" Style="{StaticResource Faint}" />
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Очистить (Esc)"
                            Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" Height="36" Margin="10,0,0,0">
                <ItemsControl ItemsSource="{Binding Periods}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PeriodItem}">
                            <RadioButton Style="{StaticResource Segment}" GroupName="period" Content="{Binding Title}" IsChecked="{Binding IsOn}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Column="2" Height="36" Width="150" Margin="10,0,0,0" Padding="12,0" CornerRadius="6" ToolTip="{Binding LiveText}"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Stroke2Brush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveOk}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LiveShort}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Margin="8,0,0,0" Content="{Binding PauseGlyph}"
                    Command="{Binding TogglePauseCommand}" ToolTip="Пауза: экран не обновляется, запись в журнал продолжается" />

            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Height="36" Margin="0,0,8,0" Command="{Binding OpenEmptyCheckCommand}"
                        ToolTip="Проверить, почему сайт или адрес не работает: DNS, подключение, блокировки, задержка, трасса (Ctrl+D)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Проверить" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="36" Margin="0,0,8,0" Command="{Binding OpenBlocksCommand}"
                        ToolTip="Правила брандмауэра, созданные из NetWatcher">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BlocksText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="36" Command="{Binding OpenExportCommand}" ToolTip="Ctrl+E">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Экспорт списка" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource Btn}" Height="36" Padding="10,0" Margin="8,0,0,0" Click="OnThemeMenu"
                        ToolTip="{Binding ThemeTitle}" AutomationProperties.Name="Тема оформления">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ThemeGlyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="6,2,0,0" Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Как в Windows" IsCheckable="False" IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="System">
                                <MenuItem.Icon><TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Светлая" IsChecked="{Binding IsThemeLight, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light">
                                <MenuItem.Icon><TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Тёмная" IsChecked="{Binding IsThemeDark, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                                <MenuItem.Icon><TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource BtnIcon}" Margin="8,0,0,0" Content="&#xE713;" Click="OnSettings" ToolTip="Настройки" />
            </StackPanel>
        </Grid>

        <!-- ============ Quick filters ============ -->
        <DockPanel Grid.Row="1" Margin="16,0,16,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FoundText}" Style="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE71C;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Top" Padding="0,6,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="Быстрые фильтры" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Top" Margin="0,5,10,0" />
                <!-- Wraps to a second line in a narrow window instead of cutting chips off. -->
                <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FilterChip}">
                            <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,4" Content="{Binding Title}" IsChecked="{Binding IsOn}" ToolTip="{Binding Hint}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DockPanel>

        <!-- ============ Banner: owner database missing ============ -->
        <Border Grid.Row="2" Margin="16,0,16,10" Padding="14,8" CornerRadius="6" Background="{DynamicResource WarnSoftBrush}"
                BorderBrush="{DynamicResource WarnStrokeBrush}" BorderThickness="1"
                Visibility="{Binding AsnBannerVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding AsnBusyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource BtnPrimarySmall}" Content="Скачать" Command="{Binding DownloadAsnCommand}" />
                    <Button Style="{StaticResource BtnSmall}" Content="Позже" Margin="8,0,0,0" Command="{Binding HideBannerCommand}" />
                </StackPanel>
                <TextBlock Text="&#xE1D3;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Колонки «Владелец» и «Сеть» пустые." FontWeight="SemiBold" />
                    <Run Text="Скачайте базу владельцев IP (около 7 МБ, обновлять раз в месяц)." />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ============ Body ============ -->
        <Border Grid.Row="3" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Programs -->
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,10,4">
                        <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding NavSortIndex}" FontSize="12" MinWidth="130" ToolTip="Порядок списка">
                            <ComboBoxItem Content="По активности" />
                            <ComboBoxItem Content="По имени" />
                            <ComboBoxItem Content="По трафику" />
                        </ComboBox>
                        <TextBlock Text="Программы" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="NavList" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="16,12,0,4" Style="{StaticResource Caption}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="Name" Converter="{StaticResource Upper}" />
                                                    <Binding Path="ItemCount" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                            <TextBlock.Visibility>
                                                <Binding Path="Name" Converter="{StaticResource TextVis}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Margin="6,1" Padding="8,6" CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <Border x:Name="bar" Width="3" CornerRadius="1.5" Margin="-8,4,0,4" HorizontalAlignment="Left"
                                                            Background="{DynamicResource AccentBrush}" Visibility="Hidden" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SelBrush}" />
                                                    <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"
                                                          Visibility="{Binding IsAll, Converter={StaticResource NotVis}}" />
                                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsAll, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <Border Grid.Column="1" Style="{StaticResource NewBadge}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Впервые вышла в сеть за последние сутки">
                                                <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NewBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border CornerRadius="8" Padding="5,0" Margin="0,0,6,0" Background="{DynamicResource DangerSoftBrush}"
                                                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Адреса, которые не отвечают или теряют пакеты (фильтр «Проблемные»)">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                                    <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10" /><Run Text=" " /><Run Text="{Binding Problems, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}" FontSize="12" ToolTip="{Binding CountTip}"
                                                       Visibility="{Binding HasLink, Converter={StaticResource NotVis}}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Состояние связи за последние 2 минуты (вкладка «Связь»)">
                                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding LinkText}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Bars}" Height="14" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                      ToolTip="Активность за последние 7 часов"
                                                      Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="3" Height="{Binding}" Margin="0,0,1,0" RadiusX="1" RadiusY="1"
                                                               VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Main: header, tabs, table -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,1,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnSmall}" Margin="0,0,8,0" Command="{Binding ToggleNotifyCommand}"
                                        Visibility="{Binding IsLinkTab, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Уведомление Windows, когда сервер программы перестаёт отвечать, и когда связь возвращается">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding NotifyText}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSmall}" Command="{Binding CopyAllIpsCommand}" ToolTip="Все IP-адреса из списка ниже">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Все IP" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Command="{Binding CopyAllDomainsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Все домены" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnPrimarySmall}" Margin="8,0,0,0" Command="{Binding OpenVpnExportCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Подсети для VPN…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border CornerRadius="8" Background="{DynamicResource AccentBrush}" Visibility="{Binding ShowProgramColumn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                                <ContentPresenter Content="{Binding HeaderNav}" ContentTemplate="{StaticResource Avatar}"
                                                  Visibility="{Binding ShowProgramColumn, Converter={StaticResource NotVis}}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="16,8,16,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsLinkTab}"
                                             ToolTip="Отвечают ли серверы программы: задержка, потери, обрывы связи">
                                    <TextBlock Text="Связь" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsDomainsTab}" ToolTip="Адреса сгруппированы по доменам">
                                    <TextBlock><Run Text="По доменам" /><Run Text=" " /><Run Text="{Binding DomainsCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Normal" /></TextBlock>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsAddressesTab}" ToolTip="Плоский список, можно сортировать по колонкам">
                                    <TextBlock><Run Text="Все адреса" /><Run Text=" " /><Run Text="{Binding AddressesCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Normal" /></TextBlock>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsDnsTab}" ToolTip="Какие имена программа спрашивала и какие адреса получила">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock><Run Text="Журнал DNS" /><Run Text=" " /><Run Text="{Binding DnsCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Normal" /></TextBlock>
                                        <Border CornerRadius="8" Padding="5,0" Margin="6,0,0,0" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding HasDnsErrors, Converter={StaticResource BoolToVis}}" ToolTip="Неудачные DNS-запросы">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"><Run Text="ошибок: " /><Run Text="{Binding DnsErrors, Mode=OneWay}" /></TextBlock>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <DataGrid x:Name="Grid" ItemsSource="{Binding Table}" SelectedItem="{Binding SelectedItem}"
                                      Visibility="{Binding IsTableTab, Converter={StaticResource BoolToVis}}"
                                      Tag="{Binding}" ContextMenu="{StaticResource RowMenu}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                      RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                      CanUserSortColumns="{Binding IsAddressesTab}" CanUserResizeRows="False" CanUserReorderColumns="False"
                                      RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}" ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ClipboardCopyMode="None" MouseDoubleClick="OnRowDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Куда" Width="2.2*" SortMemberPath="DomainText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="18" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                                               ToolTip="{Binding HealthReason}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Health}" Value="Warn">
                                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Health}" Value="Fail">
                                                                        <Setter Property="Text" Value="&#xEA39;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Grid Width="24">
                                                        <Button Style="{StaticResource BtnGhost}" Width="22" Height="22" FontSize="10" Content="{Binding Chevron}"
                                                                Command="{Binding Data.ToggleCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" ToolTip="Показать адреса" />
                                                    </Grid>
                                                    <Border Width="24" Visibility="{Binding IsChild, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding DomainText}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDomain}" Value="False">
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border CornerRadius="8" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource DangerSoftBrush}" ToolTip="{Binding BlockTip}"
                                                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="заблокировано" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource DomainMark}" ToolTip="{Binding MarkTip}"
                                                            Visibility="{Binding HasMark, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Mark}" FontSize="10.5" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Ip}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                                                        <Setter Property="FontSize" Value="13" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Style="{StaticResource NewBadge}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Программа впервые пошла сюда за последние сутки">
                                                        <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NewBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Программа" Binding="{Binding Program}" Width="1.1*"
                                                        Visibility="{Binding Data.ShowProgramColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                                    <DataGridTemplateColumn Header="Порт" Width="118">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <ItemsControl ItemsSource="{Binding Ports}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Tag}">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Владелец" Width="1.5*" SortMemberPath="Owner">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding OwnerRaw}">
                                                    <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding HasCountry, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="{Binding CountryTip}">
                                                        <TextBlock Text="{Binding Country}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Owner}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Сеть" Binding="{Binding Network}" Width="150" FontFamily="{StaticResource MonoFont}" />
                                    <DataGridTemplateColumn Header="Объём" Width="82" SortMemberPath="Bytes">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <TextBlock Text="{Binding BytesText}" ToolTip="{Binding BytesTip}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource Text2Brush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Когда" Binding="{Binding When}" SortMemberPath="LastSeen" Width="92" />
                                    <DataGridTemplateColumn Width="70" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource RowActions}">
                                                    <Button Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать IP"
                                                            Command="{Binding Data.CopyIpCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource BtnGhost}" Content="&#xE712;" ToolTip="Ещё действия" Click="OnRowMore" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid ItemsSource="{Binding DnsItems}" Visibility="{Binding IsDnsTab, Converter={StaticResource BoolToVis}}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                      BorderThickness="0" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                      RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}" ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                      EnableRowVirtualization="True" ClipboardCopyMode="ExcludeHeader">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Домен" Binding="{Binding Domain}" Width="1.6*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Программа" Binding="{Binding Program}" Width="1*"
                                                        Visibility="{Binding Data.ShowProgramColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                                    <DataGridTemplateColumn Header="Ответ" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:DnsItem}">
                                                <TextBlock Text="{Binding Addresses}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Addresses}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="92" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Link tab: is the program's server answering -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLinkTab, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="16,12,16,16">
                                    <StackPanel.Resources>
                                        <!-- Coloured summary box: green / amber / red / grey. -->
                                        <Style x:Key="Hero" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Padding" Value="16,12" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Margin" Value="0,0,0,12" />
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Ok">
                                                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarnStrokeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail">
                                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="HeroIcon" TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                            <Setter Property="FontSize" Value="24" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0,0,14,0" />
                                            <Setter Property="Text" Value="&#xE9D9;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Ok">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail">
                                                    <Setter Property="Text" Value="&#xE711;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <!-- Small coloured state label for servers and cards. -->
                                        <Style x:Key="StatePill" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Padding" Value="8,1" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Background" Value="{DynamicResource OkSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="StateText" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="Kpi" TargetType="StackPanel">
                                            <Setter Property="Margin" Value="22,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Resources>

                                    <!-- Summary -->
                                    <Border Style="{StaticResource Hero}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding LinkHasProgram, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Style="{StaticResource Kpi}" ToolTip="Средняя задержка до главного сервера за минуту (по пингу)">
                                                    <TextBlock Text="{Binding LinkLatency}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="задержка" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource Kpi}" ToolTip="Насколько скачет задержка: среднее различие соседних замеров">
                                                    <TextBlock Text="{Binding LinkJitter}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="разброс" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource Kpi}">
                                                    <TextBlock Text="{Binding LinkLoss}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="потери" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource Kpi}">
                                                    <TextBlock Text="{Binding LinkOutages}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="сбоев" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource HeroIcon}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LinkTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LinkSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding LinkSubtitle, Converter={StaticResource TextVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- No data for this program -->
                                    <Border Style="{StaticResource Card}" Visibility="{Binding LinkNoData, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                            <Run Text="За выбранный период программа не обменивалась данными, пока NetWatcher был запущен." />
                                            <Run Text="Связь оценивается по пакетам туда и обратно, поэтому видна только у работающих программ. Выберите период длиннее или запустите программу." />
                                        </TextBlock>
                                    </Border>

                                    <!-- One program -->
                                    <StackPanel Visibility="{Binding LinkHasProgram, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12,10">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Rectangle Width="12" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="задержка, мс" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
                                                        <Rectangle Width="6" Height="10" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="потери" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
                                                        <Rectangle Width="12" Height="10" Fill="{DynamicResource DangerBrush}" Opacity="0.3" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="нет связи" Style="{StaticResource Muted}" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Задержка и потери, " /><Run Text="{Binding LinkWindowText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <v:LinkChart Height="150" Points="{Binding LinkChart}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Servers -->
                                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="12,8,12,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.4*" />
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="1.3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
                                                    </Grid.Resources>
                                                    <TextBlock Text="СЕРВЕР" />
                                                    <TextBlock Grid.Column="1" Text="ПРОТ." />
                                                    <TextBlock Grid.Column="2" Text="СОСТОЯНИЕ" />
                                                    <TextBlock Grid.Column="3" Text="ЗАДЕРЖКА" />
                                                    <TextBlock Grid.Column="4" Text="РАЗБРОС" />
                                                    <TextBlock Grid.Column="5" Text="ПОТЕРИ" />
                                                    <TextBlock Grid.Column="6" Text="ОТВЕТ БЫЛ" />
                                                    <TextBlock Grid.Column="7" Text="ЗА МИНУТУ ↑ / ↓" ToolTip="Сколько отправлено и получено за последнюю минуту" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding LinkServers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LinkServerView}">
                                                            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,6" ToolTip="{Binding Reason}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2.4*" />
                                                                        <ColumnDefinition Width="58" />
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="74" />
                                                                        <ColumnDefinition Width="64" />
                                                                        <ColumnDefinition Width="56" />
                                                                        <ColumnDefinition Width="84" />
                                                                        <ColumnDefinition Width="1.3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,8,0">
                                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Address, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text3Brush}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding Owner}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Style="{StaticResource Tag}" HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding Proto}" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                                                                    </Border>
                                                                    <Border Grid.Column="2" Style="{StaticResource StatePill}">
                                                                        <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Latency}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding Jitter}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="5" Text="{Binding Loss}" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasLoss}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="6" Text="{Binding LastAnswer}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="7" Text="{Binding Traffic}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Why -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasLinkReasons, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="ПОЧЕМУ ТАК РЕШИЛИ" Style="{StaticResource Caption}" />
                                                <ItemsControl ItemsSource="{Binding LinkReasons}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3">
                                                                <TextBlock Text="•" Margin="0,0,8,0" Foreground="{DynamicResource Text3Brush}" />
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Events -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasLinkEvents, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="СОБЫТИЯ" Style="{StaticResource Caption}" />
                                                <ItemsControl ItemsSource="{Binding LinkEvents}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LinkEventView}">
                                                            <DockPanel Margin="0,3">
                                                                <TextBlock Text="{Binding Time}" Width="64" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                                                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- All programs: connection quality (router, internet, load, AIM scores) -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding LinkShowAll, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding QualityProgress}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding QualityProgress}" />
                                                    <Button Style="{StaticResource BtnSmall}" Content="Проверить под нагрузкой…" Command="{Binding RunTestCommand}"
                                                            Visibility="{Binding QualityTestIdle, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Около 20 секунд: скачивание и отправка на полной скорости, задержка в это время" />
                                                    <Button Style="{StaticResource BtnSmall}" Content="Остановить" Command="{Binding CancelTestCommand}"
                                                            Visibility="{Binding QualityTestBusy, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Качество подключения" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="за последние 10 минут" Style="{StaticResource Muted}" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                                       Visibility="{Binding QualityOn, Converter={StaticResource NotVis}}"
                                                       Text="Опорные пинги выключены в настройках — включите их, чтобы видеть качество до роутера и до интернета." />
                                            <Grid Margin="0,10,0,0" Visibility="{Binding QualityOn, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="12.5" />
                                                        <Setter Property="Margin" Value="0,2,16,2" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                    </Style>
                                                </Grid.Resources>
                                                <TextBlock Text="{Binding QualityGatewayLabel}" Foreground="{DynamicResource Text3Brush}"
                                                           ToolTip="Домашняя сеть: кабель или Wi-Fi до роутера" />
                                                <TextBlock Grid.Column="1" Text="{Binding QualityGateway}" />
                                                <TextBlock Grid.Row="1" Text="{Binding QualityInternetLabel}" Foreground="{DynamicResource Text3Brush}"
                                                           ToolTip="Весь путь до интернета; задержка и разброс — в спокойные моменты" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QualityInternet}" />
                                                <TextBlock Grid.Row="2" Text="Под нагрузкой" Foreground="{DynamicResource Text3Brush}"
                                                           ToolTip="Насколько растёт задержка, когда линия занята скачиванием или отправкой (bufferbloat)" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QualityLoad}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding QualityChips}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="12" Padding="10,3" Margin="0,0,8,4" ToolTip="{Binding Tip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="12.5">
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ClassText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding QualityHint}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                                       Visibility="{Binding QualityHint, Converter={StaticResource TextVis}}" />
                                            <TextBlock Text="{Binding QualityTest}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Muted}"
                                                       Visibility="{Binding QualityTest, Converter={StaticResource TextVis}}" />
                                            <TextBlock Margin="0,6,0,0" FontSize="11" Style="{StaticResource Faint}" TextWrapping="Wrap"
                                                       Text="Оценки — по методике Cloudflare AIM; они появляются, когда известен рост задержки под нагрузкой, а «Видео» — после теста скорости. «Под нагрузкой» без теста — по вашему же трафику: это нагрузка, какая была, а не предел линии." />
                                        </StackPanel>
                                    </Border>

                                    <!-- All programs: cards -->
                                    <ItemsControl ItemsSource="{Binding LinkCards}" Visibility="{Binding LinkShowAll, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LinkCardView}">
                                                <Button Margin="0,0,12,12" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        VerticalAlignment="Stretch" Command="{Binding Data.SelectProgramCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding Key}" ToolTip="Открыть связь этой программы">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="12">
                                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Style="{StaticResource StatePill}" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" />
                                                            </Border>
                                                            <ContentPresenter Content="{Binding Nav}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <v:LinkChart Mini="True" Height="30" Margin="0,10,0,8" Points="{Binding Chart}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"><Run Text="задержка " /><Run Text="{Binding Latency, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"><Run Text="потери " /><Run Text="{Binding Loss, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12"><Run Text="сбоев " /><Run Text="{Binding Outages, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,4,0,8">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource AllVis}">
                                                <Binding Path="HasLinkIdle" />
                                                <Binding Path="LinkShowAll" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <TextBlock Text="СЕЙЧАС НЕ ОБМЕНИВАЮТСЯ ДАННЫМИ" Style="{StaticResource Caption}" />
                                        <ItemsControl ItemsSource="{Binding LinkIdle}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LinkCardView}">
                                                    <Button Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Command="{Binding Data.SelectProgramCommand, Source={StaticResource Proxy}}"
                                                            CommandParameter="{Binding Key}" ToolTip="{Binding Sub}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ContentPresenter Content="{Binding Nav}" ContentTemplate="{StaticResource Avatar}" Margin="-4,0,6,0">
                                                                <ContentPresenter.LayoutTransform>
                                                                    <ScaleTransform ScaleX="0.65" ScaleY="0.65" />
                                                                </ContentPresenter.LayoutTransform>
                                                            </ContentPresenter>
                                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Outages, StringFormat='  · сбоев {0}'}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Связь оценивается без чтения содержимого: по пакетам туда и обратно, повторным отправкам TCP и пингу до серверов раз в 5 секунд. «Нет ответа» — программа продолжает отправлять, а сервер молчит дольше 5 секунд (для UDP — если раньше он отвечал). Если сервер не отвечает на пинг, задержка показывается как «нет пинга». При обрыве NetWatcher сам делает трассу и пишет, где путь обрывается." />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- First run / empty period -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Margin="0,40">
                                    <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />

                                    <Border Style="{StaticResource Card}" Margin="0,18,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AdminOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OkBrush}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Права администратора" FontWeight="SemiBold" />
                                                <TextBlock Text="Видны системные процессы и службы Windows" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CaptureOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OkBrush}"
                                                               Visibility="{Binding CaptureOk, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="!" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}"
                                                               Visibility="{Binding CaptureOk, Converter={StaticResource NotVis}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Домены и UDP" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CaptureText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AsnOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OkBrush}"
                                                               Visibility="{Binding AsnOk, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="3" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" Visibility="{Binding AsnOk, Converter={StaticResource NotVis}}" />
                                                </Grid>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimarySmall}" Content="Скачать" Command="{Binding DownloadAsnCommand}"
                                                    Visibility="{Binding AsnMissing, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel>
                                                <TextBlock Text="База владельцев IP" FontWeight="SemiBold" />
                                                <TextBlock Text="Нужна для владельцев сетей и списков подсетей" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource StepMark}">
                                                <TextBlock Text="4" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Изменить" Click="OnSettings" />
                                            <StackPanel>
                                                <TextBlock Text="Срок хранения журнала" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RetentionText}" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="Попробуйте найти:" Style="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,18,0,8" />
                                    <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BtnSmall}" Margin="4" Content="{Binding}"
                                                        Command="{Binding Data.SearchTextCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Nothing matches the search or filters -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                                        Visibility="{Binding ShowNothingFound, Converter={StaticResource BoolToVis}}">
                                <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Style="{StaticResource Btn}" Content="Сбросить поиск и фильтры" Margin="0,16,0,0" HorizontalAlignment="Center"
                                        Command="{Binding ResetFiltersCommand}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Details -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <Grid>
                        <!-- Selected address or domain -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Закрыть" Click="OnCloseDetails" VerticalAlignment="Top" />
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding D[Title]}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="200" />
                                        <Border Style="{StaticResource NewBadge}" Visibility="{Binding DetailsNew, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NewBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding D[Subtitle]}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="{Binding D[IpLabel], Converter={StaticResource Upper}}" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}" Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать"
                                            Command="{Binding CopyValueCommand}" CommandParameter="{Binding D[Ip]}" VerticalAlignment="Top" />
                                    <TextBox Text="{Binding D[Ip], Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="ДОМЕНЫ ЭТОГО АДРЕСА" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}" Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать"
                                            Command="{Binding CopyValueCommand}" CommandParameter="{Binding D[Domains]}" VerticalAlignment="Top" />
                                    <TextBox Text="{Binding D[Domains], Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="CIDR" FontSize="11" Padding="8,2" IsChecked="{Binding UseCidr}" ToolTip="1.2.3.0/24" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="Маска" FontSize="11" Padding="8,2" IsChecked="{Binding UseMask}" ToolTip="1.2.3.0 255.255.255.0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding D[NetworkLabel], Converter={StaticResource Upper}}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                            </DockPanel>
                            <Border Style="{StaticResource Field}" Margin="0,0,0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать"
                                            Command="{Binding CopyValueCommand}" CommandParameter="{Binding D[Network]}" VerticalAlignment="Top" />
                                    <TextBox Text="{Binding D[Network], Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Margin" Value="0,2,14,2" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Text="Владелец" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding D[Owner]}" ToolTip="{Binding D[OwnerRaw]}" />
                                    <TextBlock Grid.Row="1" Text="Страна" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding D[Country]}" />
                                    <TextBlock Grid.Row="2" Text="Протокол" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding D[Protocol]}" />
                                    <TextBlock Grid.Row="3" Text="Впервые" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding D[First]}" />
                                    <TextBlock Grid.Row="4" Text="Последний раз" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding D[Last]}" />
                                    <TextBlock Grid.Row="7" Text="Компания" Foreground="{DynamicResource Text3Brush}"
                                               ToolTip="Кому принадлежит домен (не сеть, в которой стоит сервер)" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding D[Company]}" ToolTip="{Binding D[CompanyTip]}" />
                                    <TextBlock Grid.Row="6" Text="Трафик" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding D[Traffic]}"
                                               ToolTip="Полезные данные без заголовков пакетов. Для периодов дольше часа — с точностью до часа" />
                                    <TextBlock Grid.Row="5" Text="Состояние" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding D[Health]}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Margin" Value="0,2,14,2" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding D[HealthLevel]}" Value="Fail">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding D[HealthLevel]}" Value="Warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding D[HealthLevel]}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel Visibility="{Binding D[WhatAny], Converter={StaticResource TextVis}}">
                                <TextBlock Text="ЧТО ЭТО" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding D[WhatProgramTitle], Converter={StaticResource TextVis}}">
                                            <TextBlock Text="{Binding D[WhatProgramTitle]}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding D[WhatProgram]}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding D[WhatProgramBlock]}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding D[WhatDomainTitle], Converter={StaticResource TextVis}}">
                                            <TextBlock Text="{Binding D[WhatDomainTitle]}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding D[WhatDomain]}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding D[WhatDomainBlock]}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <WrapPanel Margin="0,0,0,12">
                                <Button Style="{StaticResource BtnPrimarySmall}" Margin="0,0,8,8" Command="{Binding OpenCheckCommand}"
                                        ToolTip="Почему не работает: DNS, подключение, блокировка по имени, задержка, трасса (Ctrl+D)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Проверить соединение" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Command="{Binding PeeringDbCommand}"
                                        ToolTip="Кто владелец сети: название и тип по открытому справочнику PeeringDB">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE779;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Владелец (PeeringDB)" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Command="{Binding RdapCommand}" ToolTip="Спросить у реестра IP-адресов (RIPE, ARIN…) точный блок и организацию">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Подробно о сети (RDAP)" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Command="{Binding WhoElseCommand}" ToolTip="Найти все программы, которые ходили на этот адрес">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Кто ещё ходит сюда" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasPdb, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать"
                                                Command="{Binding CopyValueCommand}" CommandParameter="{Binding D[Pdb]}" />
                                        <TextBlock Text="ВЛАДЕЛЕЦ СЕТИ (PEERINGDB)" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Text="{Binding D[Pdb], Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasRdap, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать"
                                                Command="{Binding CopyValueCommand}" CommandParameter="{Binding D[Rdap]}" />
                                        <TextBlock Text="ДАННЫЕ РЕЕСТРА (RDAP)" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Text="{Binding D[Rdap], Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Ctrl+C" FontWeight="SemiBold" /><Run Text=" копирует выделенные строки, " /><Run Text="Ctrl+Shift+C" FontWeight="SemiBold" /><Run Text=" — только IP. Двойной щелчок по строке копирует её IP." />
                            </TextBlock>
                        </StackPanel>

                        <!-- Nothing selected: summary of the program -->
                        <StackPanel Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding D[SumTitle], Converter={StaticResource Upper}}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Margin" Value="0,3,14,3" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Text="Адресов" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding D[SumAddresses]}" />
                                    <TextBlock Grid.Row="1" Text="Сетей владельцев" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding D[SumNetworks]}" />
                                    <TextBlock Grid.Row="2" Text="Страны" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding D[SumCountries]}" />
                                    <TextBlock Grid.Row="3" Text="Без домена" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding D[SumNoDomain]}" />
                                    <TextBlock Grid.Row="4" Text="Трафик" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding D[SumTraffic]}"
                                               ToolTip="За выбранный период: получено ↓ и отправлено ↑. Полезные данные без заголовков пакетов" />
                                    <TextBlock Grid.Row="5" Text="Скорость" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding D[SumSpeed]}" ToolTip="Средняя за последние 10 секунд" />
                                    <TextBlock Grid.Row="6" Text="Трекеры" Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Hyperlink Command="{Binding OpenHistoryCommand}">Трафик за 30 дней по данным Windows…</Hyperlink>
                                    </TextBlock>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding D[SumMarked]}"
                                               ToolTip="По каталогу DuckDuckGo и WindowsSpyBlocker; фильтры «Трекеры» и «Телеметрия» покажут их" />
                                </Grid>
                            </Border>
                            <StackPanel Visibility="{Binding D[SumAny], Converter={StaticResource TextVis}}">
                                <TextBlock Text="ЧТО ЭТО" Style="{StaticResource Caption}" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding D[SumProgramTitle], Converter={StaticResource TextVis}}">
                                            <TextBlock Text="{Binding D[SumProgramTitle]}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding D[SumProgram]}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding D[SumProgramBlock]}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding D[SumDomainTitle], Converter={StaticResource TextVis}}">
                                            <TextBlock Text="{Binding D[SumDomainTitle]}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding D[SumDomain]}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding D[SumDomainBlock]}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="СЕТИ ДЛЯ ПРАВИЛ VPN / ФАЙРВОЛА" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Field}" Padding="10,8" Margin="0,0,0,10">
                                <TextBox Text="{Binding SumNetworksText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MonoFont}" MaxHeight="260"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Style="{StaticResource BtnPrimarySmall}" Command="{Binding CopySummaryNetworksCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Копировать" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Content="Другие форматы…" Command="{Binding OpenOwnerExportCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Выберите строку в таблице, чтобы увидеть подробности: домены, сеть, владельца и данные реестра." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="4" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" Style="{StaticResource Faint}" FontSize="12" Margin="16,0,0,0" ToolTip="Версия NetWatcher" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalsText}" Style="{StaticResource Muted}" FontSize="12" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaptureOk}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="●" /><Run Text=" " /><Run Text="{Binding CaptureText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding AsnText}" FontSize="12" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AsnOk}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding JournalText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Toast ============ -->
        <Border Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="14,9" CornerRadius="8"
                Background="{DynamicResource ToastBrush}" Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource ToastTextBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ToastTitle}" Foreground="{DynamicResource ToastTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastValue}" Foreground="{DynamicResource ToastAccentBrush}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                <Button Content="Отменить" Margin="14,0,0,0" Command="{Binding UndoCopyCommand}" Cursor="Hand"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#BBBBBB" TextDecorations="Underline" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Connection check side panel ============ -->
        <Grid Grid.RowSpan="5" DataContext="{Binding Diagnostics}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#47000000" MouseLeftButtonDown="OnCheckScrimClick" />
            <Border Width="660" HorizontalAlignment="Right" Background="{DynamicResource LayerBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Закрыть (Esc)" Command="{Binding CloseCommand}" />
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Проверка соединения" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Command="{Binding CopyCommand}" IsEnabled="{Binding HasVerdict}"
                                    ToolTip="Текст для отправки в чат: итог, шаги и трасса">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Копировать отчёт" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="С включённым VPN проверка идёт через него." Style="{StaticResource Faint}" FontSize="12"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                        <StackPanel>
                            <!-- What to check -->
                            <DockPanel Margin="0,0,0,6">
                                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Button Style="{StaticResource BtnPrimary}" Height="36" Content="Проверить" Command="{Binding RunCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource NotVis}}" />
                                    <Button Style="{StaticResource Btn}" Height="36" Content="Остановить" Command="{Binding StopCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <Border Height="36" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Stroke2Brush}" BorderThickness="1,1,1,2">
                                    <Grid Margin="10,0">
                                        <TextBox x:Name="CheckBox" Style="{StaticResource BareTextBox}" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Что проверить">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding RunCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="Сайт или адрес: youtube.com, 1.2.3.4, example.com:8443" Style="{StaticResource Faint}" FontSize="14"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=CheckBox, Converter={StaticResource TextVis}, ConverterParameter=invert}" />
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding Error, Converter={StaticResource TextVis}}" />

                            <!-- Verdict -->
                            <Border CornerRadius="8" Padding="14,12" Margin="0,8,0,14" BorderThickness="1"
                                    Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnStrokeBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="0,2,12,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE930;" />
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                        <Setter Property="Text" Value="&#xEA39;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{Binding VerdictTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding VerdictText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Steps -->
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StepView}">
                                        <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Top" Margin="0,2,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xEA3A;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Text" Value="&#xE895;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warn">
                                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                    <Setter Property="Text" Value="&#xE738;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Width="170" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Route -->
                            <StackPanel Visibility="{Binding HasHops, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"><Run Text="проб на узел: " /><Run Text="{Binding Rounds, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="ТРАССА — ПУТЬ ПАКЕТОВ ПО УЗЛАМ (КАК MTR)" Style="{StaticResource Caption}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="«*» — узел не отвечает. Потери на промежуточном узле, которые не продолжаются дальше, — это роутер ограничивает ответы, а не проблема. Важны потери, которые тянутся до последнего узла. «(+1)» — на этом шаге отвечают разные роутеры (балансировка)." />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                    <Grid Margin="12,6,12,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
                                        </Grid.Resources>
                                        <TextBlock Text="№" />
                                        <TextBlock Grid.Column="1" Text="АДРЕС" />
                                        <TextBlock Grid.Column="2" Text="ПОТЕРИ" />
                                        <TextBlock Grid.Column="3" Text="СР." ToolTip="Средняя задержка, мс" />
                                        <TextBlock Grid.Column="4" Text="ЛУЧШ." ToolTip="Лучшая задержка, мс" />
                                        <TextBlock Grid.Column="5" Text="ХУДШ." ToolTip="Худшая задержка, мс" />
                                        <TextBlock Grid.Column="6" Text="ВЛАДЕЛЕЦ СЕТИ" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Hops}" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HopView}">
                                                <Grid Margin="12,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Silent}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Text="{Binding Ttl}" Style="{StaticResource Faint}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Loss}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLoss}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding Avg}" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Best}" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Worst}" Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Owner}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Owner}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Export side panel ============ -->
        <Grid Grid.RowSpan="5" DataContext="{Binding Export}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#47000000" MouseLeftButtonDown="OnScrimClick" />
            <Border Width="560" HorizontalAlignment="Right" Background="{DynamicResource LayerBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,18,20,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Закрыть (Esc)" Command="{Binding CloseCommand}" />
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="Экспорт списка" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Context}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="12,2,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Enter — копировать" Style="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CopyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                        <TextBlock Text="Копировать" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Margin="8,0,0,0" Content="Сохранить .txt…" Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="20,0,20,12">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Что выгрузить" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}" Height="34" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="IP-адреса" IsChecked="{Binding IsAddresses}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="Домены" IsChecked="{Binding IsDomains}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="Подсети" IsChecked="{Binding IsSubnets}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="what" Content="Сети владельцев" IsChecked="{Binding IsOwners}"
                                                 ToolTip="Целые блоки, которые объявляет владелец (по базе AS)" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,16,0,0" IsEnabled="{Binding WidthEnabled}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WidthText}" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Text="Насколько укрупнять" FontWeight="SemiBold" FontSize="12" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                        Value="{Binding Width}" Margin="0,6,0,0" AutomationProperties.Name="Насколько укрупнять подсети" />
                                <UniformGrid Columns="5" Margin="0,2,0,0">
                                    <TextBlock Text="точно" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Text="/28" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,40,0" />
                                    <TextBlock Text="/24" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="/20" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="40,0,0,0" />
                                    <TextBlock Text="/16" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Шире — меньше строк, но в список попадут и соседние адреса, которые программа не использовала." />
                            </StackPanel>

                            <TextBlock Text="Куда будете вставлять" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6" />
                            <UniformGrid Columns="2" IsEnabled="{Binding TargetEnabled}">
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsLines}">
                                    <StackPanel>
                                        <TextBlock Text="Список по строкам" FontWeight="SemiBold" />
                                        <TextBlock Text="Обычный текст, одна сеть в строке" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsWireGuard}">
                                    <StackPanel>
                                        <TextBlock Text="WireGuard / AmneziaWG" FontWeight="SemiBold" />
                                        <TextBlock Text="AllowedIPs = 1.2.3.0/24, …" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsFirewall}">
                                    <StackPanel>
                                        <TextBlock Text="Файрвол Windows" FontWeight="SemiBold" />
                                        <TextBlock Text="Через запятую, для поля «Удалённые IP-адреса»" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="target" IsChecked="{Binding IsMask}">
                                    <StackPanel>
                                        <TextBlock Text="С маской" FontWeight="SemiBold" />
                                        <TextBlock Text="1.2.3.0 255.255.255.0 — для роутеров" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <CheckBox Content="Только IPv4" IsChecked="{Binding Ipv4Only}" Margin="0,0,20,0" />
                                <CheckBox Content="Комментарии с доменами" IsChecked="{Binding Comments}" IsEnabled="{Binding CommentsEnabled}"
                                          ToolTip="Добавляет в конец строки # домены, которые ведут в эту сеть" />
                            </StackPanel>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Faint}" FontSize="12" />
                                <TextBlock Text="Предпросмотр" FontWeight="SemiBold" FontSize="12" />
                            </DockPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Field}" Padding="10,8">
                            <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
