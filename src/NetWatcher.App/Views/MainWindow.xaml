<Window x:Class="NetWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        xmlns:vm="clr-namespace:NetWatcher.App.ViewModels"
        xmlns:v="clr-namespace:NetWatcher.App.Views"
        Title="NetWatcher"
        Width="1400" Height="880" MinWidth="1180" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/NetWatcher;component/Assets/NetWatcher.ico"
        Style="{StaticResource BaseWindow}">

    <Window.Resources>
        <v:InverseBoolToVisibility x:Key="NotVis" />
        <v:NotEmptyToVisibility x:Key="TextVis" />
        <v:UpperCase x:Key="Upper" />
        <v:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <v:AllTrueToVisibility x:Key="AllVis" />

        <!-- Letter avatar or real icon of a program. -->
        <DataTemplate x:Key="Avatar" DataType="{x:Type vm:NavItem}">
            <Grid Width="28" Height="28">
                <Border CornerRadius="7" Background="{Binding Color}" Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}">
                    <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding Icon}" Width="22" Height="22" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Context menu shared by right click and the "⋯" button of each row. -->
        <ContextMenu x:Key="RowMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Копировать IP" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyIpCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Копировать домены" Command="{Binding CopyDomainCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Копировать сеть владельца" Command="{Binding CopyNetworkCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Копировать строки целиком" InputGestureText="Ctrl+C" Command="{Binding CopyRowCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Найти всё с этим IP" Command="{Binding SearchIpCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Найти всё с этим доменом" Command="{Binding SearchDomainCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Найти всё этой программы" Command="{Binding SearchProgramCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Проверить соединение…" InputGestureText="Ctrl+D" Command="{Binding OpenCheckCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Открыть папку программы" Command="{Binding OpenFolderCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Заблокировать…" Command="{Binding BlockCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Снять блокировку…" Command="{Binding UnblockCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Разорвать соединение…" Command="{Binding CloseConnectionCommand}"
                      ToolTip="Закрыть открытые TCP-соединения программы с этим адресом: программа может подключиться снова"
                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- Server menu: only what neither the row buttons nor the details pane below offer. -->
        <ContextMenu x:Key="ServerMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Копировать IP:порт" Command="{Binding CopyServerAddressCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Найти в «Все соединения»" Command="{Binding SearchIpCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="Заблокировать…" Command="{Binding BlockCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource NotVis}}" />
            <MenuItem Header="Снять блокировку…" Command="{Binding UnblockCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsBlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Разорвать соединение…" Command="{Binding CloseConnectionCommand}"
                      ToolTip="Закрыть открытые TCP-соединения программы с этим адресом: программа может подключиться снова"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.IsTcp, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
        </ContextMenu>
        <!-- Rows: no grid lines, a soft hover, the accent-tinted selection. -->
        <Style x:Key="RowStyle" TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style x:Key="AddressRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource RowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChild}" Value="True">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <!-- The Fluent header does not show the sort direction: the arrow is ours. -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter Content="{Binding}" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" Margin="5,0,0,0" Foreground="{DynamicResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="&#xE70E;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="&#xE70D;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Row action buttons appear on hover or selection only. -->
        <Style x:Key="RowActions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FiltersButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Command" Value="{Binding ToggleFiltersCommand}" />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ToolTip" Value="Быстрые фильтры: TCP, UDP, домены, проблемные, новые, трекеры и другие" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FiltersText}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChipsOn}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FiltersOpen}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepMark" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Menu ============ -->
        <Border Width="{Binding MenuWidth}" Background="{DynamicResource NavBrush}">
            <DockPanel Margin="10,14,10,12">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="7,0,0,14" Height="30">
                        <Image Width="28" Height="28" Source="pack://application:,,,/NetWatcher;component/Assets/NetWatcher.ico" />
                        <TextBlock Text="NetWatcher" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding ToggleRailCommand}" ToolTip="{Binding MenuToggleText}" AutomationProperties.Name="{Binding MenuToggleText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="{Binding MenuToggleText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding ShowOverviewCommand}" Tag="{Binding IsOverviewPage}" ToolTip="Обзор" AutomationProperties.Name="Обзор">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="Обзор" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding ShowProgramsCommand}" Tag="{Binding MenuPrograms}" ToolTip="Программы" AutomationProperties.Name="Программы">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="Программы" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding ShowAllCommand}" Tag="{Binding MenuAll}" ToolTip="Все соединения" AutomationProperties.Name="Все соединения">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="Все соединения" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding OpenEmptyCheckCommand}" Tag="{Binding IsChecksPage}" ToolTip="Проверки" AutomationProperties.Name="Проверки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="Проверки" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding OpenBlocksCommand}" Tag="{Binding IsBlocksPage}" ToolTip="{Binding BlocksText}" AutomationProperties.Name="Блокировки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="{Binding BlocksText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource MenuItem}" Click="OnSettings" Tag="{Binding IsSettingsPage}" ToolTip="Настройки" AutomationProperties.Name="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="Настройки" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuItem}" Command="{Binding OpenGuideCommand}" ToolTip="Как пользоваться" AutomationProperties.Name="Как пользоваться">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16" Width="18" />
                            <TextBlock Text="Как пользоваться" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding MenuExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- ============ Page ============ -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Page heading ============ -->
        <DockPanel Margin="16,12,16,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn}" Height="36" Margin="0,0,8,0" Command="{Binding ToggleListCommand}"
                        Visibility="{Binding ShowListButton, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE89F;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ProgramListText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FiltersButton}" Margin="0,0,8,0" Visibility="{Binding ShowHeadingFilters, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource BtnPrimary}" Height="36" Command="{Binding OpenEmptyCheckCommand}" ToolTip="Ctrl+D"
                        Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Проверить сайт" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Height="36" Command="{Binding OpenExportCommand}" ToolTip="Ctrl+E"
                        Visibility="{Binding IsMainPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Экспорт списка" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource Muted}" />
            </StackPanel>
        </DockPanel>

        <!-- ============ Search and quick filters ============ -->
        <DockPanel Grid.Row="1" Margin="16,0,16,8" Visibility="{Binding IsMainPage, Converter={StaticResource BoolToVis}}">
            <!-- Wraps to a second line in a narrow window instead of cutting chips off. -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Chips}" Margin="0,8,0,0"
                          Visibility="{Binding ChipsVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilterChip}">
                        <ToggleButton Margin="0,0,8,4" Content="{Binding Title}" IsChecked="{Binding IsOn}" ToolTip="{Binding Hint}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.FiltersOpen, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False" />
                                                <Condition Binding="{Binding IsOn}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                        Visibility="{Binding ShowSearchBox, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FoundText}" Style="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox SelectedIndex="{Binding TableViewIndex}" Height="36" MinWidth="136" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          ToolTip="По доменам — адреса сгруппированы, Все адреса — плоский список с сортировкой"
                          Visibility="{Binding IsConnectionsTab, Converter={StaticResource BoolToVis}}">
                    <ComboBoxItem Content="По доменам" />
                    <ComboBoxItem Content="Все адреса" />
                </ComboBox>
                <Button Style="{StaticResource FiltersButton}" />
            </StackPanel>

            <Border x:Name="SearchFrame" Height="36" CornerRadius="6" Background="{DynamicResource CardBrush}" BorderThickness="1,1,1,2"
                    Visibility="{Binding ShowSearchBox, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke2Brush}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text2Brush}" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Поиск"
                             ToolTip="Ищет по программе, службе, IP, порту, домену, владельцу и стране. Несколько слов — все должны совпасть. 142.250.0.0/15 — адреса внутри подсети." />
                    <TextBlock Grid.Column="1" Text="Программа, домен, IP или подсеть" Style="{StaticResource Faint}"
                               FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                               Visibility="{Binding HasSearch, Converter={StaticResource NotVis}}" />
                    <Border Grid.Column="2" BorderBrush="{DynamicResource Stroke2Brush}" BorderThickness="1" CornerRadius="4" Padding="5,1"
                            Visibility="{Binding HasSearch, Converter={StaticResource NotVis}}">
                        <TextBlock Text="Ctrl+F" FontSize="11" Style="{StaticResource Faint}" />
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="&#xE711;" ToolTip="Очистить поиск"
                            Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- ============ Banners: a new version, the owner database missing ============ -->
        <StackPanel Grid.Row="2">
        <Border Margin="16,0,16,10" Padding="14,8" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource BtnPrimarySmall}" Content="Установить" Command="{Binding InstallUpdateCommand}" />
                    <Button Style="{StaticResource BtnSmall}" Content="Позже" Margin="8,0,0,0" Command="{Binding DismissUpdateCommand}" />
                </StackPanel>
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{Binding UpdateText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="Программа скачает её, проверит и перезапустится. Журнал, настройки и блокировки сохранятся." />
                </TextBlock>
            </DockPanel>
        </Border>
        <Border Margin="16,0,16,10" Padding="14,8" CornerRadius="6" Background="{DynamicResource WarnSoftBrush}"
                BorderBrush="{DynamicResource WarnStrokeBrush}" BorderThickness="1"
                Visibility="{Binding AsnBannerVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding AsnBusyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource BtnPrimarySmall}" Content="Скачать" Command="{Binding DownloadAsnCommand}" />
                    <Button Style="{StaticResource BtnSmall}" Content="Позже" Margin="8,0,0,0" Command="{Binding HideBannerCommand}" />
                </StackPanel>
                <TextBlock Text="&#xE1D3;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Колонки «Владелец» и «Сеть» пустые." FontWeight="SemiBold" />
                    <Run Text="Скачайте базу владельцев IP (около 7 МБ, обновлять раз в месяц)." />
                </TextBlock>
            </DockPanel>
        </Border>
        </StackPanel>

        <!-- ============ Overview ============ -->
        <ScrollViewer Grid.Row="3" Margin="16,0,16,6" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,-10,12">
                    <Border Style="{StaticResource PagePanel}" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" />
                                <TextBlock Text="Программ в сети" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding OvPrograms}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2"></TextBlock>
                            <TextBlock Text="{Binding OvProgramsHint}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PagePanel}" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" />
                                <TextBlock Text="Передано" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding OvTraffic}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2"></TextBlock>
                            <TextBlock Text="{Binding OvTrafficHint}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PagePanel}" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" />
                                <TextBlock Text="Адресов замечено" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding OvAddresses}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2"></TextBlock>
                            <TextBlock Text="{Binding OvAddressesHint}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PagePanel}" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" />
                                <TextBlock Text="Адресов с проблемами" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding OvProblems}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OvHasProblems}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding OvProblemsHint}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.27*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PagePanel}" Padding="16,12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OvLinkText}" VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OvLinkLevel}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OvLinkLevel}" Value="Warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OvLinkLevel}" Value="Fail">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Связь с интернетом" FontSize="15" FontWeight="SemiBold" />
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding QualityInternetLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,14,2" />
                                <TextBlock Grid.Column="1" Text="{Binding QualityInternet}" FontSize="12" />
                                <TextBlock Grid.Row="1" Text="{Binding QualityGatewayLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,14,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QualityGateway}" FontSize="12" />
                            </Grid>
                            <v:LinkChart Height="170" Points="{Binding OvChart}" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PagePanel}" Padding="10,12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,0,6,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Все соединения" Command="{Binding ShowAllCommand}" />
                                <TextBlock Text="Программы" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding OvTopPrograms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NavItem}">
                                        <Button Style="{StaticResource PageRow}" ToolTip="{Binding Path}"
                                                Command="{Binding DataContext.OpenProgramCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource PagePanel}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Что изменилось" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="За этот период изменений не замечено." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasOvEvents, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding OvEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OverviewEvent}">
                                    <Button Style="{StaticResource PageRow}" ToolTip="Открыть программу"
                                            Command="{Binding DataContext.OpenProgramCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" Width="48" VerticalAlignment="Center" />
                                            <Ellipse Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Ok">
                                                                <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11.5"
                                                           Visibility="{Binding Detail, Converter={StaticResource TextVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Body ============ -->
        <Border Grid.Row="3" Margin="16,0,16,6" Visibility="{Binding IsMainPage, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="280" MinWidth="200" MaxWidth="520" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="500" />
                </Grid.ColumnDefinitions>

                <!-- Programs -->
                <Border x:Name="ProgramPanel" Style="{StaticResource PagePanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,10,4">
                        <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding NavSortIndex}" FontSize="12" MinWidth="130" ToolTip="Порядок списка">
                            <ComboBoxItem Content="По активности" />
                            <ComboBoxItem Content="По имени" />
                            <ComboBoxItem Content="По трафику" />
                        </ComboBox>
                        <TextBlock Text="Программы" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="NavList" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="16,12,0,4" Style="{StaticResource Caption}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="Name" Converter="{StaticResource Upper}" />
                                                    <Binding Path="ItemCount" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                            <TextBlock.Visibility>
                                                <Binding Path="Name" Converter="{StaticResource TextVis}" />
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                <Setter Property="Visibility" Value="{Binding IsAll, Converter={StaticResource NotVis}}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Margin="6,1" Padding="8,6" CornerRadius="6" Background="{TemplateBinding Background}">
                                                <Grid>
                                                    <Border x:Name="bar" Width="3" CornerRadius="1.5" Margin="-8,4,0,4" HorizontalAlignment="Left"
                                                            Background="{DynamicResource AccentBrush}" Visibility="Hidden" />
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">

                                                    <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"
                                                          Visibility="{Binding IsAll, Converter={StaticResource NotVis}}" />
                                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ActionBrush}"
                                                Visibility="{Binding IsAll, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <Border Grid.Column="1" Style="{StaticResource NewBadge}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Впервые замечена в журнале за последние сутки">
                                                <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NewBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border CornerRadius="8" Padding="5,0" Margin="0,0,6,0" Background="{DynamicResource DangerSoftBrush}"
                                                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Адреса, которые не отвечают или теряют пакеты (фильтр «Проблемные»)">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                                    <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10" /><Run Text=" " /><Run Text="{Binding Problems, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}" FontSize="12" ToolTip="{Binding CountTip}"
                                                       Visibility="{Binding HasLink, Converter={StaticResource NotVis}}" />
                                            <!-- Fine: a green dot and the latency. A problem: one icon, the words in the tooltip. -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding LinkTip}">
                                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Ok"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding LinkText}" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Bars}" Height="14" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                      ToolTip="Активность за последние 7 часов"
                                                      Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="3" Height="{Binding}" Margin="0,0,1,0" RadiusX="1" RadiusY="1"
                                                               VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </Border>

                <!-- Splitter between the programs list and the rest; its position is kept in the settings. -->
                <GridSplitter x:Name="ProgramSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeWE" DragCompleted="OnPanelsResized" ToolTip="Потяните, чтобы изменить ширину" />

                <!-- Table above, details below; the details height is kept in the settings too. -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="DetailsRow" Height="240" MinHeight="110" />
                    </Grid.RowDefinitions>

                <!-- Main: header, tabs, table -->
                <Border Grid.Row="0" Style="{StaticResource PagePanel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnSmall}" Command="{Binding ToggleNotifyCommand}"
                                        Visibility="{Binding IsLinkTab, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Уведомление Windows, когда сервер программы перестаёт отвечать, и когда связь возвращается. В «Все программы» — для любой программы">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding NotifyText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                <!-- The same switch as in the list on the left: the globe for "Все", the avatar for a program. -->
                                <Border CornerRadius="8" Background="{DynamicResource ActionBrush}" Visibility="{Binding HeaderNav.IsAll, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource OnAccentBrush}" />
                                </Border>
                                <ContentPresenter Content="{Binding HeaderNav}" ContentTemplate="{StaticResource Avatar}"
                                                  Visibility="{Binding HeaderNav.IsAll, Converter={StaticResource NotVis}}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding HeaderTitle}">
                                <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="16,8,16,0">
                            <DockPanel>
                            <!-- Selected rows: here the commands appear without moving the table under the mouse. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,6"
                                        Visibility="{Binding SelectionBarVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <Button Style="{StaticResource BtnSmall}" Content="Строки" Margin="0,0,4,0" ToolTip="Копировать выбранные строки (Ctrl+C)"
                                        Command="{Binding CopyRowCommand}" CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
                                <Button Style="{StaticResource BtnSmall}" Content="IP" Margin="0,0,4,0" ToolTip="Копировать IP выбранных строк (Ctrl+Shift+C)"
                                        Command="{Binding CopyIpCommand}" CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
                                <Button Style="{StaticResource BtnSmall}" Content="Домены" Margin="0,0,4,0" ToolTip="Копировать домены выбранных строк"
                                        Command="{Binding CopyDomainCommand}" CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
                                <Button Style="{StaticResource BtnSmall}" Content="Снять выбор" Click="OnClearSelection" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsConnectionsTab}" ToolTip="Адреса, с которыми связывается программа">
                                    <TextBlock><Run Text="Соединения" /><Run Text=" " /><Run Text="{Binding AddressesCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Normal" /></TextBlock>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsLinkTab}"
                                             ToolTip="Отвечают ли серверы программы: задержка, потери, обрывы связи">
                                    <TextBlock Text="Связь" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource Tab}" GroupName="tab" IsChecked="{Binding IsDnsTab}" ToolTip="Какие имена программа спрашивала и какие адреса получила">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock><Run Text="Журнал DNS" /><Run Text=" " /><Run Text="{Binding DnsCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Normal" /></TextBlock>
                                        <Border CornerRadius="8" Padding="5,0" Margin="6,0,0,0" Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding HasDnsErrors, Converter={StaticResource BoolToVis}}" ToolTip="Неудачные DNS-запросы">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"><Run Text="ошибок: " /><Run Text="{Binding DnsErrors, Mode=OneWay}" /></TextBlock>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DataGrid x:Name="Grid" PreviewMouseDown="OnTableMouseDown" SelectionChanged="OnTableSelectionChanged" ItemsSource="{Binding Table}" SelectedItem="{Binding SelectedItem}"
                                      Visibility="{Binding IsTableTab, Converter={StaticResource BoolToVis}}"
                                      Tag="{Binding}" ContextMenu="{StaticResource RowMenu}" ContextMenuOpening="OnTableMenuOpening"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                      CanUserSortColumns="{Binding IsAddressesTab}" CanUserResizeRows="False" CanUserReorderColumns="False"
                                      RowStyle="{StaticResource AddressRowStyle}" CellStyle="{StaticResource CellStyle}" ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ClipboardCopyMode="None" MouseDoubleClick="OnRowDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="38" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="AllRowsCheck" Click="OnCheckAllRows" Focusable="False" MinWidth="0" Padding="0" Margin="-2,0,0,0"
                                                      ToolTip="Выбрать все показанные строки" AutomationProperties.Name="Выбрать все показанные строки" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <!-- The same selection as Ctrl and Shift; OnTableMouseDown toggles it. -->
                                                <CheckBox Focusable="False" MinWidth="0" Padding="0" VerticalAlignment="Center" ToolTip="Выбрать строку"
                                                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Программа / служба" Width="1.1*" MinWidth="110" SortMemberPath="Program"
                                                            Visibility="{Binding Data.ShowProgramColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <Button Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Открыть соединения этой программы"
                                                        Command="{Binding Data.SelectProgramCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding ProgramKey}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock x:Name="t" Text="{Binding Program}" TextTrimming="CharacterEllipsis" Background="Transparent" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Домен и IP-адрес" Width="2.4*" MinWidth="190" SortMemberPath="DomainText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <DockPanel ToolTip="{Binding AddressTip}" Background="Transparent">
                                                    <Grid Width="24" Visibility="{Binding Data.IsDomainsTab, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}">
                                                        <Button Style="{StaticResource BtnGhost}" Width="22" Height="22" FontSize="10" Content="{Binding Chevron}"
                                                                Command="{Binding Data.ToggleCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" ToolTip="Показать адреса" />
                                                    </Grid>
                                                    <Border Width="24" Visibility="{Binding IsChild, Converter={StaticResource BoolToVis}}" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource RowActions}">
                                                        <Button Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать домен" Margin="0,0,2,0"
                                                                Command="{Binding Data.CopyDomainCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding HasDomain, Converter={StaticResource BoolToVis}}" />
                                                        <Button Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать IP"
                                                                Command="{Binding Data.CopyIpCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <!-- Domain above, address below: in one line a long domain pushed the address out of the cell. -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBox Text="{Binding DomainText, Mode=OneWay}"
                                                                 Visibility="{Binding DomainText, Converter={StaticResource TextVis}}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDomain}" Value="False">
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <StackPanel Orientation="Horizontal">
                                                        <TextBox Text="{Binding Ip, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                                                            <Setter Property="FontSize" Value="13" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <Border CornerRadius="8" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource DangerSoftBrush}" ToolTip="{Binding BlockTip}"
                                                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="заблокировано" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                                        </Border>
                                                        <Border Style="{StaticResource DomainMark}" ToolTip="{Binding MarkTip}"
                                                                Visibility="{Binding HasMark, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Mark}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Style="{StaticResource NewBadge}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Обращение к адресу впервые замечено за последние сутки">
                                                            <TextBlock Text="НОВОЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NewBrush}" />
                                                        </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Протокол" Width="86" SortMemberPath="ProtocolText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <ItemsControl ItemsSource="{Binding Protocols}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Tag}">
                                                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text2Brush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Порт" Width="96" SortMemberPath="FirstPort">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <TextBlock Text="{Binding PortsText}" ToolTip="{Binding PortsText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Связь" Width="1.2*" MinWidth="120" SortMemberPath="Health">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,2" CornerRadius="5" ToolTip="{Binding LinkText}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Health}" Value="Warn">
                                                                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Health}" Value="Fail">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LinkText}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Health}" Value="Warn">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Health}" Value="Fail">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Объём" Width="82" SortMemberPath="Bytes">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <TextBlock Text="{Binding BytesText}" ToolTip="{Binding BytesTip}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Foreground="{DynamicResource Text2Brush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Строка" Width="78" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TableItem}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource RowActions}">
                                                    <Button Style="{StaticResource BtnGhost}" Content="&#xE8C8;" ToolTip="Копировать строку целиком" Margin="0,0,2,0"
                                                            Command="{Binding Data.CopyRowCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource BtnGhost}" Content="&#xE712;" ToolTip="Ещё действия" Click="OnRowMore" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid ItemsSource="{Binding DnsItems}" Visibility="{Binding IsDnsTab, Converter={StaticResource BoolToVis}}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                      BorderThickness="0" Background="Transparent"
                                      RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}" ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                      EnableRowVirtualization="True" ClipboardCopyMode="ExcludeHeader">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Домен" Binding="{Binding Domain}" Width="1.6*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Программа" Binding="{Binding Program}" Width="1*"
                                                        Visibility="{Binding Data.ShowProgramColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                                    <DataGridTemplateColumn Header="Ответ" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:DnsItem}">
                                                <TextBlock Text="{Binding Addresses}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Addresses}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="92" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Link tab: is the program's server answering -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLinkTab, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="16,12,16,16">
                                    <StackPanel.Resources>
                                        <!-- Coloured summary box: green / amber / red / grey. -->
                                        <Style x:Key="Hero" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Padding" Value="16,12" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Margin" Value="0,0,0,12" />
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Ok">
                                                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarnStrokeBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail">
                                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="HeroIcon" TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                            <Setter Property="FontSize" Value="24" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0,0,14,0" />
                                            <Setter Property="Text" Value="&#xE9D9;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Ok">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Warn">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LinkLevel}" Value="Fail">
                                                    <Setter Property="Text" Value="&#xE711;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <!-- Small coloured state label for servers and cards. -->
                                        <Style x:Key="StatePill" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Padding" Value="8,1" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Background" Value="{DynamicResource OkSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="StateText" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="Kpi" TargetType="StackPanel">
                                            <Setter Property="Margin" Value="22,0,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Resources>

                                    <!-- Summary -->
                                    <Border Style="{StaticResource Hero}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding LinkHasProgram, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Style="{StaticResource Kpi}" ToolTip="Средняя задержка до главного сервера за минуту (по пингу)">
                                                    <TextBlock Text="{Binding LinkLatency}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="задержка" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource Kpi}" ToolTip="Насколько скачет задержка: среднее различие соседних замеров">
                                                    <TextBlock Text="{Binding LinkJitter}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="разброс" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource Kpi}">
                                                    <TextBlock Text="{Binding LinkLoss}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="потери" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource Kpi}">
                                                    <TextBlock Text="{Binding LinkOutages}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="сбоев" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource HeroIcon}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LinkTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LinkSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding LinkSubtitle, Converter={StaticResource TextVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- No data for this program -->
                                    <Border Style="{StaticResource Card}" Visibility="{Binding LinkNoData, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                                            <Run Text="За выбранный период программа не обменивалась данными, пока NetWatcher был запущен." />
                                            <Run Text="Связь оценивается по пакетам туда и обратно, поэтому видна только у работающих программ. Выберите период длиннее или запустите программу." />
                                        </TextBlock>
                                    </Border>

                                    <!-- One program -->
                                    <StackPanel Visibility="{Binding LinkHasProgram, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Padding="8,1" Margin="12,0,0,0" FontSize="12"
                                                            Content="{Binding LinkChartToggleText}" Command="{Binding ToggleLinkChartCommand}"
                                                            ToolTip="Узкая полоса или полный график со шкалами; наведите на график, чтобы увидеть значения" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Rectangle Width="12" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="задержка, мс" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
                                                        <Rectangle Width="6" Height="10" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="потери" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
                                                        <Rectangle Width="12" Height="10" Fill="{DynamicResource DangerBrush}" Opacity="0.3" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="нет связи" Style="{StaticResource Muted}" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Задержка и потери, " /><Run Text="{Binding LinkWindowText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <v:LinkChart Height="{Binding LinkChartHeight}" Compact="{Binding LinkChartCompact}" Points="{Binding LinkChart}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Servers -->
                                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                            <StackPanel>
                                                <!-- Shown / total, reset, and copying of what is shown. -->
                                                <DockPanel Margin="12,10,12,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource BtnSmall}" Command="{Binding CopyShownDomainsCommand}" Margin="0,0,6,0"
                                                                ToolTip="Домены показанных серверов, по одному в строке">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                                                <TextBlock Text="Все домены" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource BtnSmall}" Command="{Binding CopyShownIpsCommand}"
                                                                ToolTip="IP-адреса показанных серверов, по одному в строке, без портов">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                                                <TextBlock Text="Все IP" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LinkShownText}" FontSize="12" Style="{StaticResource Muted}" />
                                                        <TextBlock FontSize="12" Margin="8,0,0,0" Visibility="{Binding LinkColumnFilterActive, Converter={StaticResource BoolToVis}}">
                                                            <Hyperlink Command="{Binding ResetServerFiltersCommand}" ToolTip="Сбросить фильтры столбцов этой таблицы; быстрые фильтры сверху и поиск не меняются">Сбросить фильтры</Hyperlink>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Grid Margin="12,8,12,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.4*" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="1.3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
                                                    </Grid.Resources>
                                                    <TextBlock Text="СЕРВЕР" />
                                                    <TextBlock Grid.Column="1" Text="ПРОТ." />
                                                    <TextBlock Grid.Column="2" Text="СОСТОЯНИЕ" />
                                                    <TextBlock Grid.Column="3" Text="ЗАДЕРЖКА" />
                                                    <TextBlock Grid.Column="4" Text="РАЗБРОС" />
                                                    <TextBlock Grid.Column="5" Text="ПОТЕРИ" />
                                                    <TextBlock Grid.Column="6" Text="ОТВЕТ БЫЛ" />
                                                    <TextBlock Grid.Column="7" Text="ЗА МИНУТУ ↑ / ↓" ToolTip="Сколько отправлено и получено за последнюю минуту" />

                                                    <!-- One filter per column: plain text with an arrow, like a header menu. Only the "Связь" table is affected;
                                                         the quick filters above the tabs set these columns, never the other way round. -->
                                                    <DockPanel Grid.Row="1" Margin="0,2,8,0">
                                                        <ComboBox DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterAddress}"
                                                              ToolTip="Как программа обратилась к серверу: по имени (известен ответ DNS) или сразу по IP. Домен бывает неизвестен и при обращении по имени — если программа спрашивает DNS сама (DNS через HTTPS) или узнала адрес до запуска NetWatcher">
                                                        <ComboBoxItem Content="Домен и IP" />
                                                        <ComboBoxItem Content="По домену" />
                                                        <ComboBoxItem Content="По IP" />
                                                    </ComboBox>
                                                        <TextBox x:Name="ServerFilterBox" Style="{StaticResource HeaderFilterText}" Tag="домен, IP или владелец" Text="{Binding LinkFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Часть домена, IP-адреса или владельца сети; несколько слов — все должны найтись" />
                                                    </DockPanel>
                                                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterProto}"
                                                              ToolTip="TCP или UDP">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="TCP" />
                                                        <ComboBoxItem Content="UDP" />
                                                    </ComboBox>
                                                    <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterState}"
                                                              ToolTip="Состояние сервера">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="Сбоев не видно" />
                                                        <ComboBoxItem Content="Проблемы" />
                                                        <ComboBoxItem Content="Нет ответа" />
                                                        <ComboBoxItem Content="Простаивает" />
                                                    </ComboBox>
                                                    <ComboBox Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterLatency}"
                                                              ToolTip="Границы — как в оценке Cloudflare AIM: 20, 50 и 100 мс">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="до 20 мс" />
                                                        <ComboBoxItem Content="20–50 мс" />
                                                        <ComboBoxItem Content="50–100 мс" />
                                                        <ComboBoxItem Content="от 100 мс" />
                                                        <ComboBoxItem Content="нет замера" />
                                                    </ComboBox>
                                                    <ComboBox Grid.Row="1" Grid.Column="4" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterJitter}"
                                                              ToolTip="Границы — как в оценке Cloudflare AIM: 10 и 20 мс">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="до 10 мс" />
                                                        <ComboBoxItem Content="10–20 мс" />
                                                        <ComboBoxItem Content="от 20 мс" />
                                                        <ComboBoxItem Content="нет замера" />
                                                    </ComboBox>
                                                    <ComboBox Grid.Row="1" Grid.Column="5" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterLoss}"
                                                              ToolTip="«Есть» — от 1%, как подсвечивает таблица">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="Есть" />
                                                        <ComboBoxItem Content="Нет" />
                                                        <ComboBoxItem Content="Не измерены" />
                                                    </ComboBox>
                                                    <ComboBox Grid.Row="1" Grid.Column="6" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterAnswer}"
                                                              ToolTip="«Сейчас» — ответ был за последние 5 секунд">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="Сейчас" />
                                                        <ComboBoxItem Content="Раньше" />
                                                        <ComboBoxItem Content="Не было" />
                                                    </ComboBox>
                                                    <ComboBox Grid.Row="1" Grid.Column="7" Style="{StaticResource HeaderFilter}" SelectedIndex="{Binding LinkFilterTraffic}"
                                                              ToolTip="Был ли обмен данными за последнюю минуту">
                                                        <ComboBoxItem Content="Все" />
                                                        <ComboBoxItem Content="Есть обмен" />
                                                        <ComboBoxItem Content="Без обмена" />
                                                    </ComboBox>
                                                </Grid>
                                                <ListBox x:Name="ServerList" ItemsSource="{Binding LinkServers}" SelectedItem="{Binding SelectedLinkServer}"
                                                         BorderThickness="0" Background="Transparent" Padding="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                         PreviewMouseDown="OnServerMouseDown"
                                                         ContextMenuOpening="OnServerMenuOpening" ContextMenuClosing="OnServerMenuClosing">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
                                                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Setter Property="ContextMenu" Value="{StaticResource ServerMenu}" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LinkServerView}">
                                                            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,6" ToolTip="{Binding Reason}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2.4*" />
                                                                        <ColumnDefinition Width="58" />
                                                                        <ColumnDefinition Width="1.2*" />
                                                                        <ColumnDefinition Width="74" />
                                                                        <ColumnDefinition Width="64" />
                                                                        <ColumnDefinition Width="56" />
                                                                        <ColumnDefinition Width="84" />
                                                                        <ColumnDefinition Width="1.3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Copy buttons: one click, shown on the row under the mouse and on the selected one. -->
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Panel.ZIndex="1">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <Button Style="{StaticResource BtnSmall}" Padding="8,2" Margin="0,0,4,0" ToolTip="Копировать домен"
                                                                                Command="{Binding DataContext.CopyServerDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                                Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" />
                                                                                <TextBlock Text="домен" FontSize="12" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Style="{StaticResource BtnSmall}" Padding="8,2" ToolTip="Копировать IP (без порта)"
                                                                                Command="{Binding DataContext.CopyServerIpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" />
                                                                                <TextBlock Text="IP" FontSize="12" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <!-- Name on top, address and owner below: in one line a long name hid the address. -->
                                                                    <StackPanel Margin="0,0,8,0">
                                                                        <TextBox Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Style="{StaticResource SelectableText}" ContextMenu="{StaticResource ServerMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                        <DockPanel>
                                                                            <TextBox DockPanel.Dock="Left" Text="{Binding Address, Mode=OneWay}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                                                                     Foreground="{DynamicResource Text2Brush}" Style="{StaticResource SelectableText}" ContextMenu="{StaticResource ServerMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0" />
                                                                            <TextBlock Text="{Binding Owner}" FontSize="12" Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        </DockPanel>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Style="{StaticResource Tag}" HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding Proto}" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                                                                    </Border>
                                                                    <Border Grid.Column="2" Style="{StaticResource StatePill}" ToolTip="{Binding State}">
                                                                        <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Latency}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding Jitter}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="5" Text="{Binding Loss}" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasLoss}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="6" Text="{Binding LastAnswer}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="7" Text="{Binding Traffic}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- Why -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasLinkReasons, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="ПОЧЕМУ ТАК РЕШИЛИ" Style="{StaticResource Caption}" />
                                                <ItemsControl ItemsSource="{Binding LinkReasons}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3">
                                                                <TextBlock Text="•" Margin="0,0,8,0" Foreground="{DynamicResource Text3Brush}" />
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Events -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasLinkEvents, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="СОБЫТИЯ" Style="{StaticResource Caption}" />
                                                <ItemsControl ItemsSource="{Binding LinkEvents}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LinkEventView}">
                                                            <DockPanel Margin="0,3">
                                                                <TextBlock Text="{Binding Time}" Width="64" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                                                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- All programs: connection quality (router, internet, load, AIM scores) -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding LinkShowAll, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding QualityProgress}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding QualityProgress}" />
                                                    <Button Style="{StaticResource BtnSmall}" Content="Проверить под нагрузкой…" Command="{Binding RunTestCommand}"
                                                            Visibility="{Binding QualityTestIdle, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Около 20 секунд: скачивание и отправка на полной скорости, задержка в это время" />
                                                    <Button Style="{StaticResource BtnSmall}" Content="Остановить" Command="{Binding CancelTestCommand}"
                                                            Visibility="{Binding QualityTestBusy, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Качество подключения" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="за последние 10 минут" Style="{StaticResource Muted}" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                                       Visibility="{Binding QualityOn, Converter={StaticResource NotVis}}"
                                                       Text="Опорные пинги выключены в настройках — включите их, чтобы видеть качество до роутера и до интернета." />
                                            <Grid Margin="0,10,0,0" Visibility="{Binding QualityOn, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="12.5" />
                                                        <Setter Property="Margin" Value="0,2,16,2" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                    </Style>
                                                </Grid.Resources>
                                                <TextBlock Text="{Binding QualityGatewayLabel}" Foreground="{DynamicResource Text3Brush}"
                                                           ToolTip="Домашняя сеть: кабель или Wi-Fi до роутера" />
                                                <TextBlock Grid.Column="1" Text="{Binding QualityGateway}" />
                                                <TextBlock Grid.Row="1" Text="{Binding QualityInternetLabel}" Foreground="{DynamicResource Text3Brush}"
                                                           ToolTip="Весь путь до интернета; задержка и разброс — в спокойные моменты" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QualityInternet}" />
                                                <TextBlock Grid.Row="2" Text="Под нагрузкой" Foreground="{DynamicResource Text3Brush}"
                                                           ToolTip="Насколько растёт задержка, когда линия занята скачиванием или отправкой (bufferbloat)" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QualityLoad}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding QualityChips}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="12" Padding="10,3" Margin="0,0,8,4" ToolTip="{Binding Tip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="12.5">
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ClassText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding QualityHint}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                                       Visibility="{Binding QualityHint, Converter={StaticResource TextVis}}" />
                                            <TextBlock Text="{Binding QualityTest}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Muted}"
                                                       Visibility="{Binding QualityTest, Converter={StaticResource TextVis}}" />
                                            <TextBlock Margin="0,6,0,0" FontSize="11" Style="{StaticResource Faint}" TextWrapping="Wrap"
                                                       Text="Оценки — по методике Cloudflare AIM; они появляются, когда известен рост задержки под нагрузкой, а «Видео» — после теста скорости. «Под нагрузкой» без теста — по вашему же трафику: это нагрузка, какая была, а не предел линии." />
                                        </StackPanel>
                                    </Border>

                                    <!-- All programs: the quick filters and column filters narrow the cards too. -->
                                    <TextBlock Margin="2,0,0,8" FontSize="12" Style="{StaticResource Muted}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource AllVis}">
                                                <Binding Path="LinkShowAll" />
                                                <Binding Path="LinkFilterActive" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <Run Text="{Binding LinkShownText, Mode=OneWay}" /><Run Text=" — с серверами, подходящими под фильтры" />
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <TextBlock FontSize="12" Margin="8,0,0,0" Visibility="{Binding LinkColumnFilterActive, Converter={StaticResource BoolToVis}}">
                                                <Hyperlink Command="{Binding ResetServerFiltersCommand}" ToolTip="Сбросить фильтры столбцов таблицы серверов">Сбросить фильтры</Hyperlink>
                                            </TextBlock>
                                        </InlineUIContainer>
                                    </TextBlock>

                                    <!-- All programs: cards -->
                                    <ItemsControl ItemsSource="{Binding LinkCards}" Visibility="{Binding LinkShowAll, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LinkCardView}">
                                                <Button Margin="0,0,12,12" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        VerticalAlignment="Stretch" Command="{Binding Data.SelectProgramCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding Key}" ToolTip="Открыть связь этой программы">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" BorderBrush="{DynamicResource StrokeBrush}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="12">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource HoverRow}">
                                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                                    </Style>
                                                                </Border.Style>
                                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Style="{StaticResource StatePill}" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" />
                                                            </Border>
                                                            <ContentPresenter Content="{Binding Nav}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <v:LinkChart Mini="True" Height="30" Margin="0,10,0,8" Points="{Binding Chart}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"><Run Text="задержка " /><Run Text="{Binding Latency, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"><Run Text="потери " /><Run Text="{Binding Loss, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="12"><Run Text="сбоев " /><Run Text="{Binding Outages, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /></TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,4,0,8">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource AllVis}">
                                                <Binding Path="HasLinkIdle" />
                                                <Binding Path="LinkShowAll" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <TextBlock Text="СЕЙЧАС НЕ ОБМЕНИВАЮТСЯ ДАННЫМИ" Style="{StaticResource Caption}" />
                                        <ItemsControl ItemsSource="{Binding LinkIdle}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LinkCardView}">
                                                    <Button Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Command="{Binding Data.SelectProgramCommand, Source={StaticResource Proxy}}"
                                                            CommandParameter="{Binding Key}" ToolTip="{Binding Sub}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ContentPresenter Content="{Binding Nav}" ContentTemplate="{StaticResource Avatar}" Margin="-4,0,6,0">
                                                                <ContentPresenter.LayoutTransform>
                                                                    <ScaleTransform ScaleX="0.65" ScaleY="0.65" />
                                                                </ContentPresenter.LayoutTransform>
                                                            </ContentPresenter>
                                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Outages, StringFormat='  · сбоев {0}'}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Связь оценивается без чтения содержимого: по пакетам туда и обратно, повторным отправкам TCP и пингу до серверов раз в 5 секунд. «Нет ответа» — программа продолжает отправлять, а сервер молчит дольше 5 секунд (для UDP — если раньше он отвечал). Если сервер не отвечает на пинг, задержка показывается как «нет пинга». При обрыве NetWatcher сам делает трассу и пишет, где путь обрывается." />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- First run / empty period -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Margin="0,40">
                                    <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />

                                    <Border Style="{StaticResource Card}" Margin="0,18,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AdminOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OkBrush}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Права администратора" FontWeight="SemiBold" />
                                                <TextBlock Text="Видны системные процессы и службы Windows" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CaptureOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OkBrush}"
                                                               Visibility="{Binding CaptureOk, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="!" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}"
                                                               Visibility="{Binding CaptureOk, Converter={StaticResource NotVis}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Домены и UDP" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CaptureText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StepMark}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AsnOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OkBrush}"
                                                               Visibility="{Binding AsnOk, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="3" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
