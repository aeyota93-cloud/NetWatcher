<Window x:Class="NetWatcher.App.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="560" Height="380" MinWidth="360" MinHeight="200"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Копировать" Style="{StaticResource PrimaryButton}" Click="OnCopy" />
            <Button Content="Закрыть" IsCancel="True" Click="OnClose" />
        </StackPanel>
        <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Padding="6"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
    </DockPanel>
</Window>
