<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetWatcher.App</RootNamespace>
    <AssemblyName>NetWatcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetWatcher.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Windows 11 (Fluent) theme for standard controls is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Lets the project build on Linux/macOS CI; it still runs only on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64: one NetWatcher.exe without installing .NET. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- TraceEvent looks for its native helpers next to its own dll, so unpack everything at start. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon; Assets/make-icon.js redraws it (node + playwright, then Pillow). -->
    <Resource Include="Assets\NetWatcher.ico" />
    <!-- Reference databases, downloaded by the build (CI) and built into NetWatcher.exe. -->
    <EmbeddedResource Include="Assets\ip2asn-combined.tsv.gz" LogicalName="ip2asn-combined.tsv.gz"
                      Condition="Exists('Assets\ip2asn-combined.tsv.gz')" />
    <EmbeddedResource Include="Assets\dbip-country-lite.csv.gz" LogicalName="dbip-country-lite.csv.gz"
                      Condition="Exists('Assets\dbip-country-lite.csv.gz')" />
    <EmbeddedResource Include="Assets\domain-catalog.tsv.gz" LogicalName="domain-catalog.tsv.gz"
                      Condition="Exists('Assets\domain-catalog.tsv.gz')" />
    <None Remove="Assets\make-icon.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetWatcher.Core\NetWatcher.Core.csproj" />
  </ItemGroup>

</Project>
